[Unit]
Description=MeowSystem — acerta no lançador os atalhos dos jogos do Heroic
Documentation=file:%h/.local/state/meowsystem/heroic.log
ConditionPathExists=%h/.local/state/meowsystem/raiz
StartLimitIntervalSec=600s
StartLimitBurst=15

[Service]
Type=oneshot
ExecCondition=/bin/sh -c 'C=%h/.config/meow/meow.conf; [ -f "$C" ] || exit 1; . "$C"; [ "${HEROIC_VIGIA:-sim}" = "sim" ]'
ExecStartPre=-/bin/mkdir -p %h/.local/state/meowsystem
ExecStartPre=-/usr/bin/sleep 20
ExecStart=/usr/bin/flock -w 60 -E 0 %h/.local/state/meowsystem/lock /bin/sh -c 'R=$(cat %h/.local/state/meowsystem/raiz); [ -x "$R/scripts/jogos_heroic.sh" ] || exit 3; . %h/.config/meow/meow.conf; export FLAVOR ACCENT NOME_TEMA_ICONES ICONES_COR_MARCA; exec "$R/scripts/jogos_heroic.sh"'
SuccessExitStatus=1 3
TimeoutStartSec=5min
StandardOutput=append:%h/.local/state/meowsystem/heroic.log
StandardError=inherit
SyslogIdentifier=meow-heroic
