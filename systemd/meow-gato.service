[Unit]
Description=MeowSystem — o mascote da hora (Coquinha de dia, Mimir de noite)
Documentation=file:%h/.local/state/meowsystem/raiz
ConditionPathExists=%h/.local/state/meowsystem/raiz
ConditionEnvironment=WAYLAND_DISPLAY
PartOf=cosmic-session.target
After=cosmic-session.target
StartLimitIntervalSec=300s
StartLimitBurst=20

[Service]
Type=oneshot
ExecStartPre=-/bin/mkdir -p %h/.local/state/meowsystem
ExecStart=/usr/bin/flock -n -E 0 %h/.local/state/meowsystem/lock /bin/sh -c 'C=%h/.config/meow/meow.conf; set -a; [ -f "$C" ] && . "$C"; set +a; R=$(cat %h/.local/state/meowsystem/raiz 2>/dev/null); [ -x "$R/scripts/logo.sh" ] || exit 0; LOG_NIVEL=silencioso exec "$R/scripts/logo.sh"'

SuccessExitStatus=1 3

TimeoutStartSec=120s

LogLevelMax=notice

Nice=10
IOSchedulingClass=idle
