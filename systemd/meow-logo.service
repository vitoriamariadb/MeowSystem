[Unit]
Description=MeowSystem — gira o mascote da logo ao encerrar a sessão
Documentation=file:%h/.local/state/meowsystem/raiz
ConditionPathExists=%h/.local/state/meowsystem/raiz

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/bin/sh -c 'C=%h/.config/meow/meow.conf; [ -f "$C" ] || exit 0; set -a; . "$C"; set +a; [ "${LOGO_ROTACAO:-nao}" = "sim" ] || exit 0; R=$(cat %h/.local/state/meowsystem/raiz 2>/dev/null); [ -x "$R/scripts/logo.sh" ] || exit 0; exec "$R/scripts/logo.sh" girar-vencido'

SuccessExitStatus=1 3

TimeoutStopSec=30s

StandardOutput=append:%h/.local/state/meowsystem/logo.log
StandardError=inherit

[Install]
WantedBy=default.target
