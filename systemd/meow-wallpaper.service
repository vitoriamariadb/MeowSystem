[Unit]
Description=MeowSystem — reafirma o carrossel de papéis de parede
Documentation=file:%h/.local/state/meowsystem/raiz
ConditionPathExists=%h/.local/state/meowsystem/raiz
StartLimitIntervalSec=300s
StartLimitBurst=20

[Service]
Type=oneshot

ExecStartPre=-/bin/mkdir -p %h/.local/state/meowsystem
ExecStartPre=-/usr/bin/sleep 2
ExecStart=/usr/bin/flock -n -E 0 %h/.local/state/meowsystem/lock /bin/sh -c 'C=%h/.config/meow/meow.conf; set -a; [ -f "$C" ] && . "$C"; set +a; R=$(cat %h/.local/state/meowsystem/raiz 2>/dev/null); [ -x "$R/scripts/wallpaper.sh" ] || exit 0; exec "$R/scripts/wallpaper.sh" aplicar'

SuccessExitStatus=1 3 4

TimeoutStartSec=2min

StandardOutput=append:%h/.local/state/meowsystem/wallpaper.log
StandardError=inherit
