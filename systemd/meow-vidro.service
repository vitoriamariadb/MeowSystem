[Unit]
Description=MeowSystem — devolve o vidro da janela maximizada depois que a Aparência reescreve o tema
ConditionPathExists=%h/.local/state/meowsystem/raiz
StartLimitIntervalSec=300s
StartLimitBurst=30

[Service]
Type=oneshot
ExecCondition=/bin/sh -c 'C=%h/.config/meow/meow.conf; [ -f "$C" ] || exit 1; . "$C"; [ "${AUTO_REPARO:-sim}" = "sim" ] || exit 1; case "${VIDRO_AO_MAXIMIZAR:-sim}" in nao|não|false|0) exit 1 ;; esac; exit 0'
ExecStartPre=-/usr/bin/sleep 1
ExecStart=/usr/bin/flock -w 60 -E 0 %h/.local/state/meowsystem/lock /bin/sh -c 'R=$(cat %h/.local/state/meowsystem/raiz); [ -x "$R/scripts/vidro.sh" ] || exit 3; . %h/.config/meow/meow.conf; export VIDRO_AO_MAXIMIZAR VIDRO_OPACIDADE VIDRO_OPACIDADE_PAINEL VIDRO_OPACIDADE_DOCK FLAVOR ACCENT; exec "$R/scripts/vidro.sh"'
SuccessExitStatus=1 3 4
TimeoutStartSec=2min
SyslogIdentifier=meow-vidro
