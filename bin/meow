                    "$RAIZ/scripts/icones_sistema.sh" --aplicar 2>&1; }
fix_bandeja()   { ICONES_TEMA="${NOME_TEMA_ICONES:-MeowSystem-Icons}" \
                    "$RAIZ/scripts/icones_bandeja.sh" --aplicar 2>&1; }
