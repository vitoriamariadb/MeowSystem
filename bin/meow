  esac
}

cmd_wallpaper() {
  carregar_conf || return "$MEOW_ERRO"
  local acao="${1:-estado}"
  case "$acao" in
    estado|aplicar|usar|adicionar|banir|desbanir|favoritar|desfavoritar|semear|permitir|dispensar|proximo|anterior|carrossel|lado)
      case "$acao" in aplicar|adicionar|banir|desbanir|semear|permitir|proximo|anterior|carrossel|lado) meow_travar || return "$MEOW_ERRO" ;; esac
      shift || true
      WALLPAPER_BASE="${WALLPAPER_BASE:-}" WALLPAPER_INTERVALO="${WALLPAPER_INTERVALO:-5m}" \
        WALLPAPER_ORDEM="${WALLPAPER_ORDEM:-aleatoria}" \
        WALLPAPER_FONTES_PERMITIDAS="${WALLPAPER_FONTES_PERMITIDAS-${WALLPAPER_FONTES_DELA:-}}" \
        WALLPAPER_AJUSTE="${WALLPAPER_AJUSTE:-preencher}" \
        WALLPAPER_NOITE="${WALLPAPER_NOITE:-}" WALLPAPER_NOITE_INICIO="${WALLPAPER_NOITE_INICIO:-}" \
        WALLPAPER_NOITE_FIM="${WALLPAPER_NOITE_FIM:-}" WALLPAPER_LIMIAR_LUZ="${WALLPAPER_LIMIAR_LUZ:-}" \
        "$RAIZ/scripts/wallpaper.sh" "$acao" "$@"
      return $? ;;
    fixar|recolorir|intervalo|ordem)
      meow_erro "'$acao' ainda não existe"
      meow_info "o que existe hoje: estado, aplicar, proximo, anterior, carrossel, adicionar <img|pasta>, banir <img>, favoritar <img>, semear, permitir <caminho>"
      meow_info "intervalo e ordem se mudam no $CONF (WALLPAPER_INTERVALO / WALLPAPER_ORDEM)"
      return "$MEOW_SEM_DEPENDENCIA" ;;
    *) meow_erro "uso: meow wallpaper [estado|aplicar|proximo|anterior|carrossel|adicionar <alvo>|banir <img>|semear|permitir <caminho>]"
       return "$MEOW_ERRO" ;;
  esac
}

cmd_apps() {
  carregar_conf || return "$MEOW_ERRO"
  case "${1:-tabela}" in
    tabela)
      meow_titulo "Aplicativos"
      printf '  %s%s %s %s %s%s\n' "$C_DIM" "$(pad "programa" 18)" "$(pad "instalado" 10)" "$(pad "tema" 10)" "nomes no meow.conf" "$C_ZERO"
      local pasta slugs det conf motivo rc_geral=0
      local t_inst c_inst t_tema c_tema
      while IFS=$'\t' read -r pasta slugs det conf motivo; do
        [ -n "$pasta" ] || continue
        case "$det" in
          0) t_inst="sim"; c_inst="$C_VERDE" ;;
          *) t_inst="não"; c_inst="$C_DIM" ;;
        esac
        case "$conf" in
          0) t_tema="aplicado"; c_tema="$C_VERDE" ;;
          1) t_tema="pendente"; c_tema="$C_AMARELO"; rc_geral=1 ;;
          3) t_tema="--";       c_tema="$C_DIM"
             [ "$det" = 0 ] && [ -n "$motivo" ] && t_tema="não aplica" ;;
          *) t_tema="erro";     c_tema="$C_VERM"; rc_geral=2 ;;
        esac
        printf '  %s %s%s%s %s%s%s %s\n' \
               "$(pad "$pasta" 18)" "$c_inst" "$(pad "$t_inst" 10)" "$C_ZERO" \
               "$c_tema" "$(pad "$t_tema" 10)" "$C_ZERO" "$slugs"
        [ "$conf" = 3 ] && [ "$det" = 0 ] && [ -n "$motivo" ] \
          && printf '  %s %s%s%s\n' "$(pad "" 18)" "$C_DIM" "$motivo" "$C_ZERO"
      done < <(APPS_ATIVOS="${APPS_ATIVOS:-}" FLAVOR="${FLAVOR:-}" ACCENT="${ACCENT:-}" \
        SPOTIFY_MARKETPLACE="${SPOTIFY_MARKETPLACE:-}" "$RAIZ/scripts/aplicar_apps.sh" tabela 2>/dev/null)
      printf '\n  %snome sem programa ainda não é falha: aparece só quando alguém escrever o manifesto.%s\n' \
             "$C_DIM" "$C_ZERO"
      printf '  %smeow apps aplicar [nome] tematiza; sem nome, todos.%s\n\n' "$C_DIM" "$C_ZERO"
      return "$rc_geral" ;;
    conferir)
      APPS_ATIVOS="${APPS_ATIVOS:-}" FLAVOR="${FLAVOR:-}" ACCENT="${ACCENT:-}" \
        SPOTIFY_MARKETPLACE="${SPOTIFY_MARKETPLACE:-}" "$RAIZ/scripts/aplicar_apps.sh" conferir; return $? ;;
    aplicar)
      shift
      meow_travar || return "$MEOW_ERRO"
      local lista="${APPS_ATIVOS:-}"
      [ -n "${1:-}" ] && lista="$1"
      APPS_ATIVOS="$lista" FLAVOR="${FLAVOR:-}" ACCENT="${ACCENT:-}" \
        SPOTIFY_MARKETPLACE="${SPOTIFY_MARKETPLACE:-}" "$RAIZ/scripts/aplicar_apps.sh" aplicar; local rc=$?
      [ "$rc" = "1" ] && registrar "apps aplicar ${1:-todos}"
      return "$rc" ;;
    reverter)
      shift
      [ -n "${1:-}" ] || { meow_erro "uso: meow apps reverter <nome>"; return "$MEOW_ERRO"; }
      meow_travar || return "$MEOW_ERRO"
      APPS_ATIVOS="$1" FLAVOR="${FLAVOR:-}" ACCENT="${ACCENT:-}" \
        SPOTIFY_MARKETPLACE="${SPOTIFY_MARKETPLACE:-}" "$RAIZ/scripts/aplicar_apps.sh" reverter; local rc=$?
      [ "$rc" = "1" ] && registrar "apps reverter $1"
      return "$rc" ;;
    *) meow_erro "uso: meow apps [tabela|conferir|aplicar [nome]|reverter <nome>]"; return "$MEOW_ERRO" ;;
  esac
}

declare -a WIZ_CHAVES=()
declare -A WIZ_AJUDA=() WIZ_SECAO=() WIZ_NOVO=() WIZ_ANTES=()
declare -A WIZ_ESSENCIAL=()

wiz_ler_esquema() {
  local linha chave bloco="" secao=""
  WIZ_CHAVES=(); WIZ_AJUDA=(); WIZ_SECAO=(); WIZ_ESSENCIAL=()
  [ -f "$CONF_PADRAO" ] || return "$MEOW_SEM_DEPENDENCIA"
  while IFS= read -r linha || [ -n "$linha" ]; do
    case "$linha" in
      '# --- '*)
        secao="${linha#\# --- }"; secao="${secao%%-*}"
        secao="${secao%"${secao##*[![:space:]]}"}"
        bloco=""; continue ;;
      '# @ '*|'# > '*)
        continue ;;
      '#'*)  bloco="$bloco$linha"$'\n'; continue ;;
      '')    bloco=""; continue ;;
    esac
    case "$linha" in
      [A-Za-z_]*=*)
        chave="${linha%%=*}"
        case "$chave" in *[!A-Za-z0-9_]*) bloco=""; continue ;; esac
        [ -n "${WIZ_SECAO[$chave]+x}" ] || WIZ_CHAVES+=("$chave")
        WIZ_AJUDA[$chave]="$bloco"; WIZ_SECAO[$chave]="$secao"
        case "$bloco" in *'[essencial]'*) WIZ_ESSENCIAL[$chave]=1 ;; esac
        ;;
    esac
    bloco=""
  done < "$CONF_PADRAO"
  [ "${#WIZ_CHAVES[@]}" -gt 0 ]
}

wiz_linha_da_chave() {
  grep -E -- "^[[:space:]]*(export[[:space:]]+)?$1=" "$2" 2>/dev/null | tail -n1
}

wiz_valor_da_linha() {
  local resto="${1#*=}"
  case "$resto" in
    '"'*) resto="${resto#\"}"; printf '%s' "${resto%%\"*}" ;;
    "'"*) resto="${resto#\'}"; printf '%s' "${resto%%\'*}" ;;
    *)    printf '%s' "${resto%%[[:space:]#]*}" ;;
  esac
}

wiz_comentario_da_linha() {
  local linha="$1" resto="${1#*=}" cauda
  case "$resto" in
    '"'*) cauda="${resto#\"}"; cauda="${cauda#*\"}" ;;
    "'"*) cauda="${resto#\'}"; cauda="${cauda#*\'}" ;;
    *)    cauda="$linha" ;;
  esac
  case "$cauda" in *'#'*) printf '%s' "$(printf '%s' "${cauda#*#}" | sed 's/^ *//')" ;; esac
}

wiz_opcoes() {
  local chave="$1" ajuda="$2" inline="$3" l tok saida=""
  if [ "$chave" = "LOGO" ]; then logos_disponiveis; return 0; fi
  while IFS= read -r l; do
    case "$l" in *'|'*) ;; *) continue ;; esac
    l="${l#\#}"; l="${l%%(*}"
    saida=""
    while IFS= read -r tok || [ -n "$tok" ]; do
      tok="${tok#"${tok%%[![:space:]]*}"}"; tok="${tok%"${tok##*[![:space:]]}"}"
      case "$tok" in
        ''|*[!A-Za-z0-9_.:+-]*) saida=""; break ;;
      esac
      saida="$saida$tok"$'\n'
    done < <(printf '%s' "$l" | tr '|' '\n')
    [ -n "$saida" ] && { printf '%s' "$saida"; return 0; }
  done <<< "$ajuda"$'\n'"$inline"

  local tabela padrao_bruto
  tabela="$(printf '%s\n' "$ajuda" \
    | grep -oP '^#\s{2,}\K[a-z][a-z0-9_-]{1,14}(?=\s{2,}\S)' 2>/dev/null || true)"
  [ "$(printf '%s' "$tabela" | grep -c .)" -ge 3 ] || return 0
  padrao_bruto="$(wiz_valor_da_linha "$(wiz_linha_da_chave "$chave" "$CONF_PADRAO")")"
  printf '%s\n' "$tabela" | grep -qxF -- "$padrao_bruto" || return 0
  printf '%s' "$tabela"
  return 0
}

wiz_lista_editar() {
  local valor="$1"; shift
  local -a itens=() novos=()
  local op alvo item achou
  IFS=',' read -r -a itens <<< "$valor"
  for op in "$@"; do
    alvo="${op#[+-]}"
    [ -n "$alvo" ] || continue
    case "$op" in
      +*) achou=0
          for item in "${itens[@]}"; do [ "$item" = "$alvo" ] && achou=1; done
          [ "$achou" = "0" ] && itens+=("$alvo") ;;
      -*) novos=()
          for item in "${itens[@]}"; do [ "$item" = "$alvo" ] || novos+=("$item"); done
          itens=("${novos[@]}") ;;
    esac
  done
  local fora; fora="$(IFS=','; printf '%s' "${itens[*]}")"
  printf '%s' "$fora"
}

wiz_ajuda_linhas() {
  printf '%s' "$1" | sed 's/^# \{0,1\}//'
}

wiz_bruto() {
  local linha; linha="$(wiz_linha_da_chave "$1" "$2")"
  [ -n "$linha" ] || linha="$(wiz_linha_da_chave "$1" "$CONF_PADRAO")"
  wiz_valor_da_linha "$linha"
}

wiz_perguntar() {
  local chave="$1" arq="$2"
  local linha bruto inline ajuda opcoes resp mostrado expandido n_ajuda
  linha="$(wiz_linha_da_chave "$chave" "$arq")"
  [ -n "$linha" ] || linha="$(wiz_linha_da_chave "$chave" "$CONF_PADRAO")"
  bruto="$(wiz_valor_da_linha "$linha")"
  inline="$(wiz_comentario_da_linha "$linha")"
  ajuda="${WIZ_AJUDA[$chave]:-}"
  ajuda="${ajuda//\[essencial\] /}"
  ajuda="$(printf '%s' "$ajuda" | grep -v '^#[[:space:]]*\[essencial\][[:space:]]*$' || true)"
  opcoes="$(wiz_opcoes "$chave" "$ajuda" "$inline")"
  [ -z "$opcoes" ] && case "$bruto" in sim|nao) opcoes=$'sim\nnao' ;; esac
  n_ajuda="$(printf '%s' "$ajuda" | grep -c '^#' || true)"

  expandido="${!chave:-}"
  mostrado="$bruto"
  case "$bruto" in
    *'$'*) [ -n "$expandido" ] && [ "$expandido" != "$bruto" ] \
             && mostrado="$bruto  ->  $expandido" ;;
  esac

  local visivel=""
  [ -n "$ajuda" ] && visivel="$(wiz_ajuda_linhas "$ajuda" | grep -v '^[[:space:]]*$' | head -n 3)"

  printf '\n  %s%s%s\n' "$C_MAUVE$C_FORTE" "$chave" "$C_ZERO"
  [ -n "$inline" ] && printf '    %s%s%s\n' "$C_DIM" "$inline" "$C_ZERO"
  if [ -n "$visivel" ]; then
    printf '%s\n' "$visivel" | while IFS= read -r l; do
      printf '    %s%s%s\n' "$C_DIM" "$l" "$C_ZERO"
    done
    [ "${n_ajuda:-0}" -gt 3 ] && printf '    %s(? mostra o comentário inteiro)%s\n' "$C_DIM" "$C_ZERO"
  fi
  if [ -n "$opcoes" ]; then
    case "$visivel$inline" in
      *'|'*) ;;
      *) printf '    %s%s%s\n' "$C_AZUL" "$(printf '%s' "$opcoes" | em_linha)" "$C_ZERO" ;;
    esac
  fi
  case "$bruto" in
    *,*) printf '    %s+slug acrescenta · -slug remove · ou digite a lista inteira%s\n' "$C_DIM" "$C_ZERO" ;;
  esac

  while :; do
    printf '  %s[%s]%s %s>%s ' "$C_DIM" "$mostrado" "$C_ZERO" "$C_MAUVE" "$C_ZERO"
    resp=""
    read -r -t "${MEOW_TIMEOUT:-300}" resp || {
      printf '\n'; meow_info "sem resposta — nada foi gravado"; return 1; }
    case "$resp" in
      '')      return 0 ;;
      q|Q|sair) meow_info "saindo — nada foi gravado"; return 1 ;;
      '?')     printf '\n'; wiz_ajuda_linhas "$ajuda" | sed "s/^/    /"; printf '\n'; continue ;;
    esac
    case "$resp" in
      *'"'*|*'#'*) meow_erro 'sem aspas duplas nem # no valor — eles quebram a linha do conf'; continue ;;
    esac
    case "$resp" in
      [+-]*) local -a ops=(); read -r -a ops <<< "${resp//,/ }"
             resp="$(wiz_lista_editar "$bruto" "${ops[@]}")" ;;
    esac
    [ "$resp" = "$bruto" ] && return 0
    if [ -n "$opcoes" ] && ! grep -qxF -- "$resp" <<< "$opcoes"; then
      printf '    %s"%s" não está na lista.%s usar assim mesmo? (s/N) ' "$C_AMARELO" "$resp" "$C_ZERO"
      local ok=""
      read -r -t "${MEOW_TIMEOUT:-300}" ok || { printf '\n'; return 1; }
      case "$ok" in s|S|sim|Sim) ;; *) continue ;; esac
    fi
    WIZ_ANTES[$chave]="$bruto"; WIZ_NOVO[$chave]="$resp"
    return 0
  done
}

cmd_configurar() {
  carregar_conf || return "$MEOW_ERRO"
  local todas=0
  case "${1:-}" in --tudo|-a) todas=1; shift ;; esac
  local so_uma=""
  case "${1:-}" in
    "") ;;
    -h|--help)
      printf 'uso: meow configurar [--tudo] [CHAVE]\n'
      printf '     sem nada, pergunta só as chaves essenciais.\n'
      printf '     --tudo pergunta o meow.conf inteiro, na ordem do arquivo.\n'
      return 0 ;;
    *) so_uma="$1" ;;
  esac
  wiz_ler_esquema || { meow_erro "não consegui ler as chaves de $CONF_PADRAO"; return "$MEOW_ERRO"; }

  local fonte="$CONF"; [ -f "$fonte" ] || fonte="$CONF_PADRAO"
  local chave achou=0
  if [ -n "$so_uma" ]; then
    for chave in "${WIZ_CHAVES[@]}"; do [ "$chave" = "$so_uma" ] && achou=1; done
    [ "$achou" = "1" ] || {
      meow_erro "não existe a chave '$so_uma' no meow.conf"
      meow_info "as que existem: $(printf '%s\n' "${WIZ_CHAVES[@]}" | em_linha)"
      return "$MEOW_SEM_DEPENDENCIA"; }
  fi

  meow_titulo "MeowSystem — configurar"
  campo "arquivo" "$CONF"
  [ "$fonte" = "$CONF_PADRAO" ] && meow_info "ainda não há $CONF — os padrões vêm de $CONF_PADRAO"

  if [ ! -t 0 ]; then
    printf '\n'
    for chave in "${WIZ_CHAVES[@]}"; do
      [ -n "$so_uma" ] && [ "$chave" != "$so_uma" ] && continue
      campo "$chave" "$(wiz_bruto "$chave" "$fonte")"
    done
    printf '\n'
    meow_info "sem terminal interativo — nada foi perguntado e nada foi escrito"
    meow_info "num terminal: meow configurar    ·    ou edite $CONF na mão"
    printf '\n'
    return 0
  fi

  printf '\n  %sENTER mantém o valor · ? mostra a ajuda inteira · q sai sem gravar%s\n' \
         "$C_DIM" "$C_ZERO"
  WIZ_NOVO=(); WIZ_ANTES=()
  local secao_atual="" saiu=0
  for chave in "${WIZ_CHAVES[@]}"; do
    [ -n "$so_uma" ] && [ "$chave" != "$so_uma" ] && continue
    [ -z "$so_uma" ] && [ "$todas" = "0" ] && [ -z "${WIZ_ESSENCIAL[$chave]:-}" ] && continue
    if [ -z "$so_uma" ] && [ "${WIZ_SECAO[$chave]}" != "$secao_atual" ]; then
      secao_atual="${WIZ_SECAO[$chave]}"
      meow_passo "${secao_atual:-Configuração}"
    fi
    wiz_perguntar "$chave" "$fonte" || { saiu=1; break; }
  done

  if [ -z "$so_uma" ] && [ "$saiu" = "0" ]; then
    local _fl _ac _par _caps="" _c
    _fl="${WIZ_NOVO[FLAVOR]:-$(wiz_bruto FLAVOR "$fonte")}"
    _ac="${WIZ_NOVO[ACCENT]:-$(wiz_bruto ACCENT "$fonte")}"
    _par="$_fl-$_ac"
    if [ -n "$_fl" ] && [ -n "$_ac" ] && [ -z "$(meow_captura "$_par")" ] \
       && { python3 "$RAIZ/scripts/derivar_acento.py" --conferir "$_par" >/dev/null 2>&1
            [ "$?" != "1" ]; }; then
      while IFS= read -r _c; do
        [ -n "$_c" ] || continue
        [ "$_c" = "original" ] && continue
        _caps="$_caps$_c "
      done < <(meow_capturas)
      _caps="${_caps% }"
      printf '\n'
      meow_info "o par \"$_par\" não tem captura de referência no repositório"
      meow_info "  as que há: ${_caps:-nenhuma}"
      meow_info "  isto NÃO fecha a porta: o tema deste par sai por DERIVAÇÃO da"
      meow_info "  paleta, e a captura é refinamento, não requisito."
      meow_info "  o que muda: a etapa \"tema\" do install.sh se pula e o COSMIC fica"
      meow_info "  com as cores que já estava usando. O backup de \"voltar ao tema de"
      meow_info "  antes\" é feito de qualquer jeito, na primeira passagem."
    fi
  fi

  if [ -z "$so_uma" ] && [ "$todas" = "0" ] && [ "$saiu" = "0" ]; then
    local n_ess="${#WIZ_ESSENCIAL[@]}"
    meow_info "as outras $(( ${#WIZ_CHAVES[@]} - n_ess )) chaves ficaram no padrão"
    meow_info "  ver todas:  meow configurar --tudo   ·   uma só:  meow configurar PASTAS_XDG"
    meow_info "  ou abra o arquivo:  \$EDITOR $CONF"
  fi

  if [ "${#WIZ_NOVO[@]}" = "0" ]; then
    printf '\n'
    [ "$saiu" = "1" ] || meow_ok "nada mudou — $CONF não foi tocado"
    printf '\n'
    return 0
  fi
  if [ "$saiu" = "1" ]; then
    printf '\n'
    meow_aviso "saiu no meio — as ${#WIZ_NOVO[@]} respostas anteriores foram descartadas"
    printf '\n'
    return 0
  fi

  meow_passo "O que muda no meow.conf"
  local texto
  texto="$(cat "$fonte")"
  for chave in "${WIZ_CHAVES[@]}"; do
    [ -n "${WIZ_NOVO[$chave]+x}" ] || continue
    printf '    %s- %s="%s"%s\n' "$C_VERM"  "$chave" "${WIZ_ANTES[$chave]}" "$C_ZERO"
    printf '    %s+ %s="%s"%s\n' "$C_VERDE" "$chave" "${WIZ_NOVO[$chave]}"  "$C_ZERO"
    texto="$(conf_texto_definir "$texto" "$chave" "${WIZ_NOVO[$chave]}")"
  done
  printf '\n'

  meow_escrever "$CONF" "$texto" 644
  local rc=$?
  case "$rc" in
    0) meow_ok "$CONF já estava assim — nada foi escrito"; printf '\n'; return 0 ;;
    1) if meow_seco; then
         meow_muda "MEOW_DRY_RUN=1 — o meow.conf NÃO foi escrito"
         printf '\n'
         return "$MEOW_DIVERGENTE"
       fi
       meow_ok "gravado em $CONF"
       registrar "configurar: $(printf '%s\n' "${!WIZ_NOVO[@]}" | sort | em_linha)" ;;
    *) meow_erro "não consegui gravar $CONF"; return "$MEOW_ERRO" ;;
  esac

  if [ "${MEOW_WIZARD_SEM_APLICAR:-0}" = "1" ]; then
    meow_info "o install.sh segue daqui com os valores novos"
    printf '\n'
    return "$MEOW_DIVERGENTE"
  fi

  printf '\n  aplicar agora? (S/n) '
  local resp=""
  if [ "${MEOW_SIM:-0}" = "1" ]; then
    resp="s"; printf 's\n'
  else
    read -r -t "${MEOW_TIMEOUT:-300}" resp || resp="n"
  fi
  case "$resp" in
    n|N|nao|não|Nao|Não)
      printf '\n'
      meow_info "não apliquei. Quando quiser: meow aplicar"
      printf '\n'
      return "$MEOW_DIVERGENTE" ;;
  esac
  printf '\n'
  cmd_aplicar
}

cmd_aplicar() {
  local seco="${MEOW_DRY_RUN:-0}"
  case "${1:-}" in
    --seco|--dry-run) seco=1 ;;
    "") ;;
    *) meow_erro "uso: meow aplicar [--seco]"; return "$MEOW_ERRO" ;;
  esac
  MEOW_DRY_RUN="$seco" "$RAIZ/install.sh"
}

desfazer_lancador() {
  local d arq alvo n=0
  local -A visto=()
  for d in "$MEOW_ESTADO"/backups/*-sistema; do
    [ -d "$d" ] || continue
    while IFS= read -r arq; do
      alvo="${arq#"$d"}"
      [ -n "${visto[$alvo]:-}" ] && continue
      visto[$alvo]=1
      if meow_seco; then meow_muda "devolveria $alvo"; n=$((n+1)); continue; fi
      if meow_desktop_escrever "$alvo" "$arq"; then n=$((n+1))
      else meow_aviso "não consegui devolver $alvo"; fi
    done < <(find "$d" -type f 2>/dev/null | sort)
  done
  if [ "$n" = "0" ]; then
    meow_aviso "não há backup de .desktop do sistema em $MEOW_ESTADO/backups"
    return "$MEOW_SEM_DEPENDENCIA"
  fi
  meow_seco || meow_desktop_banco /usr/share/applications
  meow_ok "$n arquivo(s) devolvidos ao estado do apt"
  return "$MEOW_DIVERGENTE"
}

guarda_original() {
  local origem_cap aqui
  origem_cap="$(sed -n 's/^origem: //p' "$RAIZ/assets/temas/capturados/original/captura.txt" 2>/dev/null | head -n1)"
  aqui="máquina $(printf '%s' "$COSMIC" | sha256sum | cut -c1-16)"
  if [ -n "$origem_cap" ] && [ "$origem_cap" != "$aqui" ] && [ "$origem_cap" != "$COSMIC" ] \
     && [ "${MEOW_TEMA_DE_OUTRA_MAQUINA:-0}" != "1" ]; then
    meow_erro "a captura 'original' foi tirada de OUTRA máquina ($origem_cap)"
    meow_info "  aplicá-la aqui instalaria o tema de fábrica de outra pessoa e"
    meow_info "  apagaria as chaves que ela não tem."
    meow_info "  $2"
    [ -n "${3:-}" ] && meow_info "  $3"
    meow_info "  se é mesmo o tema de fábrica de outra máquina que você quer:"
    meow_info "      MEOW_TEMA_DE_OUTRA_MAQUINA=1 $1"
    return 1
  fi
  return 0
}

cmd_desfazer() {
  case "${1:-}" in --lancador) shift; desfazer_lancador; return $? ;; esac
  carregar_conf --ponte-opcional || return "$MEOW_ERRO"

  local primeiro="" d
  for d in "$MEOW_ESTADO"/backups/*-tema-PRIMEIRO-*; do
    [ -d "$d" ] && { primeiro="$d"; break; }
  done
  if [ -n "$primeiro" ]; then
    local tem_tema=0 f
    for f in "$primeiro"/com.system76.CosmicTheme.*; do [ -e "$f" ] && { tem_tema=1; break; }; done
    if [ "$tem_tema" = "0" ]; then
      meow_info "o backup de antes ($(basename "$primeiro" | cut -c1-19)) não tem tema do COSMIC:"
      meow_info "  antes do MeowSystem esta máquina usava o tema de fábrica, sem nada gravado"
      return "$MEOW_OK"
    fi
    meow_info "devolvendo o COSMIC ao estado de $(basename "$primeiro" | cut -c1-19)"
    if [ -t 0 ] && [ "${MEOW_SIM:-0}" != "1" ]; then
      printf '  %sisto devolve o tema do COSMIC para antes do MeowSystem.%s\n' "$C_AMARELO" "$C_ZERO"
      printf '  continuar? (s/N) '
      local r=""
      read -r -t "${MEOW_TIMEOUT:-30}" r || true
      case "$r" in s|S|sim|Sim) ;; *) printf '\n  cancelado.\n'; return 0 ;; esac
    fi
    meow_travar || return "$MEOW_ERRO"
    if meow_seco; then
      meow_muda "copiaria $primeiro/com.system76.CosmicTheme.* para $COSMIC/"
      return "$MEOW_DIVERGENTE"
    fi
    if [ -n "${MEOW_BACKUPS:-}" ]; then
      while IFS= read -r -d '' f; do
        meow_guardar_antes "$COSMIC/${f#"$primeiro"/}"
      done < <(find "$primeiro" -path "$primeiro/com.system76.CosmicTheme.*" -type f -print0)
    fi
    cp -a "$primeiro"/com.system76.CosmicTheme.* "$COSMIC/" || return "$MEOW_ERRO"
    registrar "desfazer -> $primeiro"
    notificar "MeowSystem" "Tema devolvido ao estado de antes da instalação."
    meow_ok "pronto — o COSMIC relê por inotify, sem relogar"
    return "$MEOW_OK"
  fi

  if [ ! -d "$RAIZ/assets/temas/capturados/original" ]; then
    meow_erro "não há backup pré-instalação nem captura 'original'"
    meow_info "  isso quer dizer que o MeowSystem nunca escreveu tema aqui — nada a desfazer"
    return "$MEOW_SEM_DEPENDENCIA"
  fi
  guarda_original "meow desfazer" \
    "o ponto de volta DESTA máquina nasce na primeira passagem do" \
    "«Instalar tudo» (etapa 'backup_tema'); antes dela não há tema de antes." \
    || return "$MEOW_SEM_DEPENDENCIA"
  if [ -t 0 ] && [ "${MEOW_SIM:-0}" != "1" ]; then
    printf '  %sisto devolve o tema do COSMIC para o tema "original".%s\n' "$C_AMARELO" "$C_ZERO"
    printf '  continuar? (s/N) '
    local resp=""
    read -r -t "${MEOW_TIMEOUT:-30}" resp || true
    case "$resp" in s|S|sim|Sim) ;; *) printf '\n  cancelado.\n'; return 0 ;; esac
  fi
  meow_travar || return "$MEOW_ERRO"
  "$RAIZ/scripts/aplicar_tema.sh" original; local rc=$?
  if [ "$rc" = "0" ] && ! meow_seco; then
    registrar "desfazer -> original"
    notificar "MeowSystem" "Tema devolvido para a captura original."
  fi
  return "$rc"
}

cmd_restaurar() {
  local pasta="${1:-}" alvo estado painel=0 n=0 falhou=0 tmp
  [ -n "$pasta" ] && [ -f "$pasta/tocados.tsv" ] || { meow_ok "nada a restaurar"; return "$MEOW_OK"; }
  meow_travar || return "$MEOW_ERRO"
  while IFS=$'\t' read -r alvo estado; do
    case "$alvo" in /*) ;; *) continue ;; esac
    meow_destino_permitido "$alvo" || { falhou=1; continue; }
    if meow_seco; then meow_muda "devolveria $alvo"; n=$((n + 1)); continue; fi
    case "$estado" in
      existia)
        mkdir -p "$(dirname "$alvo")" || { falhou=1; continue; }
        tmp="$(mktemp -p "$(dirname "$alvo")" ".atomicwrite.meow.XXXXXX")" || { falhou=1; continue; }
        rm -f -- "$tmp"
        if cp -a -- "$pasta/antes$alvo" "$tmp" && mv -fT -- "$tmp" "$alvo"; then
          meow_muda "voltou: ${alvo/#$HOME/\~}"
          meow_manifesto_registrar "$alvo"
        else
          rm -f -- "$tmp"; falhou=1; continue
        fi ;;
      novo)
        [ -e "$alvo" ] || [ -L "$alvo" ] || continue
        rm -f -- "$alvo" || { falhou=1; continue; }
        meow_muda "saiu: ${alvo/#$HOME/\~}" ;;
      pasta)
        rm -rf -- "$alvo" && mkdir -p "$(dirname "$alvo")" \
          && cp -a -- "$pasta/antes$alvo" "$alvo" || { falhou=1; continue; }
        meow_muda "voltou: ${alvo/#$HOME/\~}/" ;;
      pasta-nova)
        [ -e "$alvo" ] || continue
        rm -rf -- "$alvo" || { falhou=1; continue; }
        meow_muda "saiu: ${alvo/#$HOME/\~}/" ;;
      *) continue ;;
    esac
    n=$((n + 1))
    case "$alvo" in */com.system76.CosmicPanel*) painel=1 ;; esac
  done < <(tac "$pasta/tocados.tsv")
  if [ "$painel" = "1" ] && ! meow_seco; then
    MEOW_QUEM_RECICLA="meow restaurar" "$RAIZ/scripts/painel.sh" reciclar || true
  fi
  [ "$falhou" = "1" ] && { meow_erro "parte do estado de antes não voltou"; return "$MEOW_ERRO"; }
  [ "$n" -gt 0 ] && { registrar "restaurar -> $(basename "$pasta")"; meow_ok "o estado de antes voltou ($n arquivo(s))"; return "$MEOW_DIVERGENTE"; }
  meow_ok "já estava como antes"
  return "$MEOW_OK"
}

cmd_log() {
  local arq="$MEOW_ESTADO/meow.log"
  [ -f "$arq" ] || { meow_aviso "ainda não há log em $arq"; return "$MEOW_SEM_DEPENDENCIA"; }
  meow_titulo "Últimas 50 linhas — $arq"
  local l quando resto
  while IFS= read -r l; do
    quando="${l%% *}"; resto="${l#* }"
    case "$resto" in
      *falhou*|*erro*|*falhos=[1-9]*)
        printf '  %s%s%s %s%s%s\n' "$C_DIM" "$quando" "$C_ZERO" "$C_VERM" "$resto" "$C_ZERO" ;;
      *aplicad*|*consertou*|*mexeu=1*)
        printf '  %s%s%s %s%s%s\n' "$C_DIM" "$quando" "$C_ZERO" "$C_VERDE" "$resto" "$C_ZERO" ;;
      *)
        printf '  %s%s%s %s\n' "$C_DIM" "$quando" "$C_ZERO" "$resto" ;;
    esac
  done < <(tail -n 50 "$arq")
  printf '\n'
  return 0
}

menu_itens() {
  printf 'status\tPainel de estado: flavor, accent, tema, ícones, papel de parede e o que está divergente.\n'
  printf 'doctor\tRoda todas as conferências em ensaio e lista as divergências. Não escreve nada.\n'
  printf 'doctor --consertar\tConfere e aplica só o que falhou. Não usa sudo e não baixa nada.\n'
  printf 'tema\tMostra o tema escolhido, o que está no ar, e os temas prontos.\n'
  local n
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    printf 'tema %s\tAplica o tema "%s" por cópia, sem passar pela GUI.\n' "$n" "$n"
  done < <(capturas)
  printf 'tema claro\tEscreve is_dark=false. Claro e escuro são o MESMO tema, com um interruptor.\n'
  printf 'tema escuro\tEscreve is_dark=true.\n'
  printf 'tema auto\tDeixa o horário decidir (claro das 7h às 18h, por padrão).\n'
  printf 'logo\tLista as variantes de logo do painel.\n'
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    printf 'logo %s\tTroca a logo do painel e o botão do dock para a variante %s.\n' "$n" "$n"
  done < <(logos_disponiveis)
  printf 'icones\tEstado do tema de ícones: qual está selecionado e quantos arquivos tem.\n'
  printf 'icones reconstruir\tRemonta MeowSystem-Icons e as pastas coloridas.\n'
  printf 'wallpaper\tEstado do carrossel: pasta, quantas imagens, intervalo e ordem.\n'
  printf 'apps\tTabela: módulo, app instalado, tema aplicado ou pendente.\n'
  printf 'leitura\tModo de leitura: que degrau o relógio pede AGORA, o que a tela mostra, e se o compositor já sabe ler os dois números.\n'
  printf 'leitura remover\tZera temperatura e textura e desarma o relógio do modo de leitura.\n'
  printf 'abrir\tAbre o painel de configuração visual no navegador: as chaves e as ações, com a saída ao vivo.\n'
  printf 'configurar\tPergunta chave por chave o que está no meow.conf. ENTER mantém; no fim grava e oferece aplicar.\n'
  printf 'aplicar\tRoda o install.sh inteiro. Idempotente: nada é escrito duas vezes.\n'
  printf 'log\tÚltimas 50 linhas do log do MeowSystem.\n'
  printf 'desfazer\tDevolve o tema do COSMIC para a captura "original".\n'
}

menu_numerado() {
  local -a cmds=() descs=()
  local linha desc
  while IFS=$'\t' read -r linha desc; do
    cmds+=("$linha"); descs+=("$desc")
  done < <(menu_itens)

  meow_titulo "meow"
  local i
  for i in "${!cmds[@]}"; do
    printf '  %s%2d%s  %-22s %s%s%s\n' "$C_MAUVE" "$((i+1))" "$C_ZERO" \
           "${cmds[$i]}" "$C_DIM" "${descs[$i]}" "$C_ZERO"
  done
  printf '\n'

  if [ ! -t 0 ]; then
    meow_info "sem terminal interativo: o menu fica de fora, e os verbos acima valem direto"
    return 0
  fi
  printf '  %sescolha (ENTER cancela):%s ' "$C_MAUVE" "$C_ZERO"
  local escolha=""
  read -r -t "${MEOW_TIMEOUT:-60}" escolha || { printf '\n'; return 0; }
  [ -n "$escolha" ] || { printf '  cancelado.\n'; return 0; }
  case "$escolha" in
    ''|*[!0-9]*) meow_erro "não é um número: $escolha"; return "$MEOW_ERRO" ;;
  esac
  [ "$escolha" -ge 1 ] && [ "$escolha" -le "${#cmds[@]}" ] || {
    meow_erro "fora da lista: $escolha"; return "$MEOW_ERRO"; }
  local -a partes=()
  read -r -a partes <<< "${cmds[$((escolha-1))]}"
  printf '\n  %s>>>%s meow %s\n\n' "$C_MAUVE" "$C_ZERO" "${partes[*]}"
  despachar "${partes[@]}"
}

cmd_menu() {
  carregar_conf || return "$MEOW_ERRO"
  if ! meow_tem fzf || [ ! -t 0 ]; then
    menu_numerado
    return $?
  fi

  local selecao rc itens
  itens="$(menu_itens)"
  selecao="$(fzf \
      --height=60% --layout=reverse --border=rounded \
      --margin=1 --padding=1 \
      --prompt="  Meow > " \
      --header="  ENTER executar | ESC sair" \
      --color="bg+:#313244,fg+:#cdd6f4,hl:#cba6f7,hl+:#f5c2e7,pointer:#a6e3a1,marker:#a6e3a1,prompt:#cba6f7,header:#6c7086,border:#6c7086" \
      --preview-window="right:50%:wrap" \
      --delimiter=$'\t' --with-nth=1 \
      --preview='printf "%s\n" {2}' <<< "$itens")"
  rc=$?
  if [ "$rc" = "130" ]; then printf '  %scancelado.%s\n' "$C_DIM" "$C_ZERO"; return 0; fi
  if [ "$rc" != "0" ] || [ -z "$selecao" ]; then return 0; fi

  local cmd="${selecao%%$'\t'*}"
  local -a partes=()
  read -r -a partes <<< "$cmd"
  printf '\n  %s>>>%s meow %s\n' "$C_MAUVE" "$C_ZERO" "${partes[*]}"
  despachar "${partes[@]}"
}

cmd_ajuda() {
  local nome_pack
  nome_pack="$(python3 "$RAIZ/scripts/pack.py" adocao \
                 "${PACK:-$(meow_conf_valor PACK || true)}" \
                 "${FLAVOR:-$(meow_conf_valor FLAVOR || true)}" 2>/dev/null \
               | sed -n 's/^nome=//p')"
  printf '\nmeow%s para o COSMIC\n' "${nome_pack:+ — $nome_pack}"
  cat <<'FIM'

  meow                         menu interativo (fzf; sem ele, menu numerado)
  meow status                  painel de estado e o que está divergente
  meow doctor                  confere tudo em seco. Sai 1 se houver divergência
  meow doctor --consertar      confere e aplica só o que falhou

  meow tema                    tema alvo, tema ativo e capturas disponíveis
  meow tema <captura>          aplica a captura por cópia (sem GUI)
  meow tema claro|escuro|auto  troca o modo e grava MODO no meow.conf
  meow tema capturar <nome>    fotografa o estado atual como captura <nome>
  meow tema desfazer           o mesmo que meow desfazer

  meow logo                    variantes de logo do painel
  meow logo <variante>         troca a logo do painel e o botão do dock
  meow logo listar             o acervo, quem está no ar e POR QUÊ (fase e janela)
  meow logo girar              passa ao próximo mascote — só no modo LOGO_MODO="rotacao";
                               no padrão ("hora") quem manda é o relógio, e o
                               comando diz isso em vez de fingir efeito

  meow icones                  estado do tema de ícones
  meow icones reconstruir      remonta o tema e as pastas coloridas
  meow icones fonte <nome>     de onde sai aquele ícone, e o que deriva dele

  meow wallpaper               estado do carrossel
  meow wallpaper aplicar       liga/reafirma a rotação nativa do COSMIC
  meow wallpaper proximo       avança para a próxima imagem do grupo (fixa por 30m)
  meow wallpaper anterior      volta para a anterior
  meow wallpaper carrossel     solta a fixação e devolve a rotação agora
  meow files-menu              estado dos 2 itens de papel de parede no menu da área de trabalho
  meow files-menu build        compila o cosmic-files patchado da versão instalada
  meow wallpaper adicionar <alvo>   copia imagem ou pasta para ativos/
  meow wallpaper banir <img>   move para banidos/ (nunca apaga)
  meow wallpaper desbanir <nome>  devolve de banidos/ para ativos/ E tira do BANIDOS.txt
  meow wallpaper semear        baixa a coleção do pack no ar (commit pinado; usa rede)

  meow apps                    tabela: módulo, instalado, tema
  meow apps aplicar [slug]     tematiza um app, ou todos
  meow apps reverter <slug>    desfaz num app (só o spotify sabe hoje; slug obrigatório)

  meow pack                    os theme packs instalados, e se cada um valida
  meow pack info <id>          o que é próprio e o que é herdado no pack
  meow pack construir <id>     refaz o que o pack deriva, dentro do próprio pack
  meow pack sincronizar <id>   compara a arte copiada com a origem; só lê
                               (o --help do subcomando tem a lista inteira)

  meow leitura                 que degrau o modo de leitura pede agora
  meow leitura aplicar         põe o degrau da hora (o timer já faz sozinho)
  meow leitura remover         zera temperatura e textura, e desarma o timer

  meow compositor [--seco]     recompila o cosmic-comp com os patches de patches/ e
                               instala (sudo só no fim; vale no próximo login)
  meow compositor validar      confere se a série entra na versão instalada

  meow abrir                   abre o painel de configuração no navegador
                               (127.0.0.1, porta efêmera, token de sessão) — é a
                               mesma coisa que o ícone "MeowSystem" do lançador

  meow configurar              wizard curto: só as chaves essenciais
  meow configurar --tudo       pergunta o meow.conf inteiro, chave por chave
  meow configurar <CHAVE>      pergunta uma chave só (ex.: meow configurar ACCENT)
  meow ativar [--seco]         roda o install.sh inteiro (o mesmo que 'aplicar')
  meow aplicar [--seco]        idem — os dois nomes valem
  meow desfazer                volta o tema do COSMIC para antes do MeowSystem
  meow desfazer --lancador     devolve os .desktop de /usr/share ao estado do apt
  meow log                     últimas 50 linhas do log

Variáveis:
  MEOW_DRY_RUN=1    não escreve nada
  MEOW_RAIZ         onde está o clone do MeowSystem
  MEOW_RAIZ_EXTRA   um lugar a mais onde procurar o clone (ex.: outro disco)
  MEOW_CONF         outro meow.conf
  MEOW_SIM=1        não pergunta nada (o desfazer, e o "aplicar agora?" do wizard)
  MEOW_TEMA_DE_OUTRA_MAQUINA=1
                    deixa o desfazer aplicar uma captura tirada de outro home
  MEOW_TIMEOUT      segundos de espera em cada pergunta (300 no wizard)

Códigos de saída: 0 certo · 1 divergente · 2 erro · 3 falta dependência.

FIM
  return 0
}

cmd_painel() {
  case "${1:-estado}" in
    conferir|teto|estado|reciclar|laco) "$RAIZ/scripts/painel.sh" "$1" ;;
    -h|--help)
      meow_titulo "meow painel"
      printf '  meow painel estado     diagnóstico de uma tela\n'
      printf '  meow painel teto       a conta do raio (altura, teto, compositor)\n'
      printf '  meow painel conferir   corta o raio no que cabe, se for preciso\n'
      printf '  meow painel reciclar   SIGTERM no painel, pela porta única\n\n'
      printf '  O supervisor roda como meow-painel.service; ele repõe a barra em\n'
      printf '  segundos quando ela cai, porque o cosmic-session desiste depois de\n'
      printf '  ~20 mortes na mesma sessão (o backoff dele não tem teto e nunca zera).\n'
      ;;
    *) meow_erro "verbo desconhecido: $1"; meow_info "veja: meow painel --help"; return "$MEOW_ERRO" ;;
  esac
}

cmd_leitura() {
  local verbo="${1:-estado}"

  carregar_conf || return "$MEOW_ERRO"

  case "$verbo" in
    aplicar|conferir|estado|remover) "$RAIZ/scripts/leitura.sh" "$verbo" ;;
    adotar) shift; "$RAIZ/scripts/leitura.sh" adotar "$@" ;;
    -h|--help)
      meow_titulo "meow leitura"
      printf '  meow leitura estado     que degrau o relógio pede AGORA e o que a tela mostra\n'
      printf '  meow leitura conferir   0 conforme · 1 divergente · 4 escolha sua\n'
      printf '  meow leitura aplicar    põe o degrau da hora (o timer faz isto sozinho)\n'
      printf '  meow leitura remover    zera os dois números e desarma o timer\n'
      printf '  meow leitura adotar CHAVE...  o applet passa a guardar o valor do meow.conf\n\n'
      printf '  O horário mora no APPLET da topbar, não no meow.conf: as chaves\n'
      printf '  leitura_hora_inicio/fim de com.system76.CosmicComp. O applet só as\n'
      printf '  escreve quando você mexe nele; até lá vale o padrão do meow.conf —\n'
      printf '  e o estado diz na cara qual das duas fontes está mandando.\n\n'
      printf '  Quem PINTA é o cosmic-comp recompilado (etapa 1). Até você deslogar\n'
      printf '  depois desse build, escrever aqui é inofensivo e não muda um pixel.\n'
      ;;
    *) meow_erro "verbo desconhecido: $verbo"; meow_info "veja: meow leitura --help"; return "$MEOW_ERRO" ;;
  esac
}

cmd_compositor() {
  local verbo="compilar" seco="${MEOW_DRY_RUN:-0}"
  local -a resto=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --seco|--dry-run) seco=1 ;;
      *) resto+=("$1") ;;
    esac
    shift
  done
  [ "${#resto[@]}" -gt 0 ] && verbo="${resto[0]}"

  case "$verbo" in
    compilar|validar)
      [ "$seco" = "1" ] || meow_travar || return "$MEOW_ERRO"
      MEOW_DRY_RUN="$seco" "$RAIZ/scripts/compositor_patches.sh" "$verbo" ;;
    conferir|reverter|qual)
      MEOW_DRY_RUN="$seco" "$RAIZ/scripts/compositor_patches.sh" "$verbo" ;;
    ativar|desativar)
      [ "$seco" = "1" ] || meow_travar || return "$MEOW_ERRO"
      MEOW_DRY_RUN="$seco" "$RAIZ/scripts/compositor_patches.sh" "$verbo" ;;
    -h|--help|ajuda)
      meow_titulo "meow compositor"
      printf '  meow compositor [--seco]   baixa o fonte da versão instalada, aplica a série de\n'
      printf '                             patches/, compila (~4 min) e guarda o build em\n'
      printf '                             ~/.local/libexec/meow/cosmic-comp/<versão> — sem sudo\n'
      printf '  meow compositor validar    baixa o fonte e só roda o dry-run da série nele\n'
      printf '  meow compositor conferir   os marcadores no disco e na sessão (é a linha do doctor)\n'
      printf '  meow compositor reverter   diz como voltar ao binário do pacote\n'
      printf '  meow compositor ativar     liga o shim em ~/.local/bin: o próximo login usa o build\n'
      printf '  meow compositor desativar  desliga o shim: o próximo login volta a /usr/bin\n'
      printf '  meow compositor qual       o binário que o próximo login vai rodar\n\n'
      printf '  Ele só compila sobre uma versão que esteja em patches/versao, e diz por quê\n'
      printf '  quando recusa. A tela de login não vê o shim: ela fica sempre de fábrica.\n'
      ;;
    *) meow_erro "verbo desconhecido: $verbo"; meow_info "veja: meow compositor --help"; return "$MEOW_ERRO" ;;
  esac
}

cmd_pack() {
  local acao="${1:-listar}"; shift 2>/dev/null || true
  case "$acao" in
    validar|--validar)
      local alvo="${1:-${PACK:-}}"
      if [ -z "$alvo" ]; then
        carregar_conf 2>/dev/null || true
        alvo="${PACK:-}"
      fi
      [ -n "$alvo" ] || { meow_erro "diga qual pack: meow pack validar <id-ou-caminho>"; return "$MEOW_ERRO"; }
      python3 "$RAIZ/scripts/pack.py" validar "$alvo"
      ;;
    info|informacao|informação)
      local alvo="${1:-${PACK:-}}"
      if [ -z "$alvo" ]; then
        carregar_conf 2>/dev/null || true
        alvo="${PACK:-$(meow_pack_dir)}"
        alvo="${alvo:-$(meow_pack_padrao_dir)}"
      fi
      python3 "$RAIZ/scripts/pack.py" info "$alvo"
      ;;
    listar|lista|ls)
      local achou=0 base d
      meow_titulo "Theme packs"
      while IFS= read -r base; do
        [ -d "$base" ] || continue
        for d in "$base"/*/; do
          [ -f "$d/pack.json" ] || continue
          achou=1
          local id nome
          id="$(basename "${d%/}")"
          nome="$(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1]))["nome"])' "$d/pack.json" 2>/dev/null || echo "$id")"
          nome="$(meow_texto_seguro "$nome")"; id="$(meow_texto_seguro "$id")"
          if python3 "$RAIZ/scripts/pack.py" validar "${d%/}" >/dev/null 2>&1; then
            meow_ok "$id — $nome"
          else
            meow_aviso "$id — $nome (não valida: meow pack validar $id)"
          fi
          printf '       %s\n' "$(meow_texto_seguro "${d%/}")"
        done
      done < <(python3 "$RAIZ/scripts/pack.py" raizes)
      [ "$achou" = 1 ] || meow_pula "nenhum pack instalado"
      ;;
    construir|build)
      local alvo="${1:-}"
      [ -n "$alvo" ] || { meow_erro "diga qual pack construir: meow pack construir <id>"; return "$MEOW_ERRO"; }
      local -a seco=()
      meow_seco && seco=(--seco)
      python3 "$RAIZ/scripts/pack.py" construir "$alvo" ${seco[@]+"${seco[@]}"}
      ;;
    usar|use)
      local alvo="" pedido="" aplicar=1 arg
      for arg in "$@"; do
        case "$arg" in
          --sem-aplicar) aplicar=0 ;;
          -h|--help)
            printf 'uso: meow pack usar <id> [flavor] [--sem-aplicar]\n\n'
            printf '  Grava PACK e FLAVOR no meow.conf e aplica. Sem flavor, fica o que\n'
            printf '  está no ar se ele for do pack; senão, o padrão do pack.\n'
            return 0 ;;
          -*) meow_erro "opção desconhecida: $arg"; meow_info "veja: meow pack usar --help"; return "$MEOW_ERRO" ;;
          *)
            if [ -z "$alvo" ]; then alvo="$arg"
            elif [ -z "$pedido" ]; then pedido="$arg"
            else meow_erro "sobrou um argumento: $arg"; return "$MEOW_ERRO"
            fi ;;
        esac
      done
      [ -n "$alvo" ] || {
        meow_erro "diga qual pack usar: meow pack usar <id> [flavor]"
        meow_info "os que existem: meow pack listar"
        return "$MEOW_ERRO"
      }
      local agora_pack agora_flavor plano novo_pack novo_flavor porque
      agora_pack="$(meow_conf_valor PACK || true)"
      agora_flavor="$(meow_conf_valor FLAVOR || true)"
      plano="$(FLAVOR="$agora_flavor" python3 "$RAIZ/scripts/pack.py" usar "$alvo" ${pedido:+"$pedido"})" \
        || { meow_info "nada foi gravado — o meow.conf continua como estava"; return "$MEOW_ERRO"; }
      novo_pack="$(sed -n 's/^PACK=//p' <<< "$plano")"
      novo_flavor="$(sed -n 's/^FLAVOR=//p' <<< "$plano")"
      porque="$(sed -n 's/^PORQUE=//p' <<< "$plano")"
      [ -n "$novo_pack" ] && [ -n "$novo_flavor" ] || {
        meow_erro "o scripts/pack.py não disse qual pack e qual flavor gravar"
        return "$MEOW_ERRO"
      }

      meow_titulo "Trocar de pack"
      campo "pack"   "${agora_pack:-(nenhum escrito — valia a adoção pelo FLAVOR)}  ->  $novo_pack"
      campo "flavor" "${agora_flavor:-(nenhum)}  ->  $novo_flavor ($porque)"

      local copia texto
      copia="$(mktemp -d)" || return "$MEOW_ERRO"
      trap 'rm -rf "$copia"' EXIT
      trap 'exit 143' TERM; trap 'exit 130' INT; trap 'exit 129' HUP
      if [ -f "$CONF" ]; then texto="$(cat "$CONF")"; else texto="$(cat "$CONF_PADRAO")"; fi
      texto="$(meow_conf_texto_definir "$texto" PACK "$novo_pack")"
      texto="$(meow_conf_texto_definir "$texto" FLAVOR "$novo_flavor")"
      printf '%s\n' "$texto" > "$copia/meow.conf"

      local junto
      junto="$(python3 "$RAIZ/scripts/migrar_conf.py" "$copia/meow.conf" "$CONF_PADRAO" \
                 --so-vestigios --pack-de-antes "$agora_pack" "$agora_flavor" 2>/dev/null)" || junto=""
      junto="${junto#*: }"

      local restos="" fora="" linha chave dono onde
      linha="$(MEOW_RAIZ="$RAIZ" MEOW_CONF="$copia/meow.conf" MEOW_CONF_PADRAO="$CONF_PADRAO" \
        python3 -I - "$RAIZ" 2>/dev/null <<'PY'
import os, sys
sys.path.insert(0, os.path.join(sys.argv[1], "app"))
import servidor
APOSENTADAS = {"MEOW_FAMILIA_PALETA"}
com_cartao = set()
for item in servidor.ler_esquema():
    com_cartao.add(item["chave"])
    if item.get("vestigio_de_pack"):
        print("%s\t%s\tcartao" % (item["chave"], item["vestigio_de_pack"]["pack"]))
for chave in sorted(servidor.valores_brutos()):
    v = None if chave in com_cartao or chave in APOSENTADAS else servidor._vestigio_de_pack(chave)
    if v:
        print("%s\t%s\tfora" % (chave, v["pack"]))
PY
      )" || meow_info "não consegui perguntar ao painel o que fica de outro pack — confira lá, depois da troca"
      while IFS=$'\t' read -r chave dono onde; do
        [ -n "$chave" ] || continue
        restos="${restos:+$restos, }$chave («$dono»)"
        [ "$onde" = "fora" ] && fora="${fora:+$fora, }$chave"
      done <<< "$linha"
      if [ -n "$restos" ]; then
        meow_aviso "continuam valendo, citando outro pack que não o «$novo_pack»: $restos"
        meow_info "  o meow.conf vence o pack, então elas seguem valendo; no painel, cada uma com cartão aparece como «Vestígio do pack»"
        [ -z "$fora" ] || meow_info "  sem cartão no painel, só no meow.conf: $fora"
      fi

      local par
      par="$novo_flavor-$(meow_conf_valor ACCENT || printf 'mauve')"
      aplicar_tema_da_troca() {
        (
          export PACK="$novo_pack" FLAVOR="$novo_flavor"
          meow_seco || meow_travar || exit "$MEOW_ERRO"
          meow_ponte_python >/dev/null || exit "$MEOW_ERRO"
          "$RAIZ/scripts/aplicar_tema.sh" "$par"
        )
        case "$?" in
          0|1) ;;
          3) meow_aviso "o pack «$novo_pack» não tem captura para '$par' — o tema do COSMIC não troca, e o instalador abaixo diz o que falta" ;;
          *) meow_aviso "o tema do COSMIC não trocou para '$par' — o instalador abaixo tenta de novo, do jeito dele" ;;
        esac
      }

      if meow_seco; then
        local rc_ensaio
        meow_muda "gravaria PACK=\"$novo_pack\" e FLAVOR=\"$novo_flavor\" em $CONF — ensaio: o arquivo não é tocado"
        [ -z "$junto" ] || meow_muda "levaria junto, do pack de antes para o «$novo_pack»: $junto"
        if [ "$aplicar" = "1" ]; then
          meow_info "o tema '$par' e o ensaio do instalador olham a troca, e não o conf do disco"
          aplicar_tema_da_troca
          MEOW_CONF="$copia/meow.conf" MEOW_DRY_RUN=1 "$RAIZ/install.sh"; rc_ensaio=$?
        else
          rc_ensaio="$MEOW_DIVERGENTE"
        fi
        rm -rf "$copia"; trap - EXIT TERM INT HUP
        return "$rc_ensaio"
      fi
      rm -rf "$copia"; trap - EXIT TERM INT HUP

      local rc_pack rc_flavor
      conf_definir PACK "$novo_pack"; rc_pack=$?
      conf_definir FLAVOR "$novo_flavor"; rc_flavor=$?
      if [ "$rc_pack" -ge 2 ] || [ "$rc_flavor" -ge 2 ]; then
        meow_erro "não consegui gravar em $CONF"
        return "$MEOW_ERRO"
      fi
      if [ -n "$junto" ]; then
        junto="$(python3 "$RAIZ/scripts/migrar_conf.py" "$CONF" "$CONF_PADRAO" \
                   --so-vestigios --pack-de-antes "$agora_pack" "$agora_flavor" 2>&1)" \
          || { meow_erro "não consegui levar o ponteiro e as pastas junto: $junto"; return "$MEOW_ERRO"; }
        [ -z "$junto" ] || meow_muda "levado junto, do pack de antes para o «$novo_pack»: ${junto#*: }"
      fi
      if [ "$rc_pack" = "0" ] && [ "$rc_flavor" = "0" ]; then
        meow_ok "o meow.conf já dizia PACK=\"$novo_pack\" e FLAVOR=\"$novo_flavor\""
      else
        meow_muda "gravado em $CONF: PACK=\"$novo_pack\" e FLAVOR=\"$novo_flavor\""
        registrar "pack usar $novo_pack flavor=$novo_flavor"
      fi
      if [ "$aplicar" = "0" ]; then
        meow_info "aplicar fica para depois: meow aplicar"
        return 0
      fi
      meow_info "o tema do COSMIC primeiro, como decisão: '$par'"
      aplicar_tema_da_troca
      meow_info "agora o instalador inteiro, porque trocar de pack mexe em quase todas as etapas"
      cmd_aplicar
      ;;
    raizes|raízes)
      meow_info "onde o MeowSystem procura um pack, nesta ordem:"
      python3 "$RAIZ/scripts/pack.py" raizes | sed 's/^/       /'
      ;;
    sincronizar|sync)
      local alvo="${1:-}"
      if [ -z "$alvo" ]; then
        carregar_conf 2>/dev/null || true
        alvo="$(meow_pack_dir)"
        [ -n "$alvo" ] || alvo="$(meow_pack_padrao_dir)"
      fi
      python3 "$RAIZ/scripts/pack.py" sincronizar "$alvo"
      ;;
    novo|criar)
      local alvo="${1:-}"
      [ -n "$alvo" ] || { meow_erro "diga o nome do pack novo: meow pack novo <id>"; return "$MEOW_ERRO"; }
      shift
      carregar_conf || return "$MEOW_ERRO"
      local -a seco=()
      meow_seco && seco=(--seco)
      python3 "$RAIZ/scripts/pack.py" novo "$alvo" "$@" ${seco[@]+"${seco[@]}"}
      ;;
    exportar|export)
      local alvo="${1:-}"
      [ -n "$alvo" ] || { meow_erro "diga qual pack exportar: meow pack exportar <id> [arquivo.meowpack]"; return "$MEOW_ERRO"; }
      shift
      local -a seco=()
      meow_seco && seco=(--seco)
      python3 "$RAIZ/scripts/pack.py" exportar "$alvo" "$@" ${seco[@]+"${seco[@]}"}
      ;;
    exportar-tema|export-theme)
      local alvo="${1:-}"
      [ -n "$alvo" ] || { meow_erro "diga qual pack: meow pack exportar-tema <id> [flavor] [arquivo.tar.gz]"; return "$MEOW_ERRO"; }
      shift
      "$RAIZ/scripts/exportar_tema.sh" "$alvo" "$@"
      ;;
    importar|import)
      local arquivo="${1:-}"
      [ -n "$arquivo" ] || { meow_erro "diga qual arquivo: meow pack importar <arquivo.meowpack|arquivo.csv>"; return "$MEOW_ERRO"; }
      shift
      local -a seco=()
      meow_seco && seco=(--seco)
      python3 "$RAIZ/scripts/pack.py" importar "$arquivo" "$@" ${seco[@]+"${seco[@]}"}
      ;;
    remover|remove)
      local alvo="${1:-}"
      [ -n "$alvo" ] || { meow_erro "diga qual pack remover: meow pack remover <id>"; return "$MEOW_ERRO"; }
      shift
      carregar_conf || return "$MEOW_ERRO"
      local -a seco=()
      meow_seco && seco=(--seco)
      local rc=0
      PACK="${PACK:-}" FLAVOR="${FLAVOR:-}" \
        python3 "$RAIZ/scripts/pack.py" remover "$alvo" "$@" ${seco[@]+"${seco[@]}"} || rc=$?
      [ "$rc" = 0 ] && registrar "pack remover $alvo"
      return "$rc"
      ;;
    de-csv|csv)
      local arq="${1:-}"
      [ -n "$arq" ] || { meow_erro "diga qual CSV: meow pack de-csv <cores.csv> > paleta.json"; return "$MEOW_ERRO"; }
      [ $# -eq 1 ] || { meow_erro "um CSV só, e o destino vai pelo '>': meow pack de-csv $arq > paleta.json"; return "$MEOW_ERRO"; }
      python3 "$RAIZ/scripts/pack.py" de-csv "$arq"
      ;;
    -h|--help|ajuda)
      printf 'uso: meow pack [listar|usar <id>|validar <id>|info <id>|construir <id>|sincronizar <id>|novo <id>|exportar <id>|exportar-tema <id>|importar <arquivo>|remover <id>|de-csv <arq>|raizes]\n\n'
      printf '  listar           os packs instalados, e se cada um valida\n'
      printf '  usar <id> [fl]   troca o pack da máquina: grava PACK e FLAVOR e aplica\n'
      printf '  validar <id>     confere o pack inteiro; 0 = ok\n'
      printf '  info <id>        o que é próprio e o que é herdado, categoria a categoria\n'
      printf '  construir <id>   refaz o que o pack deriva, escrevendo só dentro dele\n'
      printf '  sincronizar <id> compara a arte copiada com a origem; só lê, nunca copia\n'
      printf '  novo <id>        um pack seu, a partir do que está no ar; o resto ele herda\n'
      printf '    --de-csv <arq> a paleta vem do CSV slot,flavor,hex; o resto, do pack padrão\n'
      printf '  exportar <id> [arquivo.meowpack] [--sem-imagens]\n'
      printf '                   o pack num arquivo só, para passar a alguém\n'
      printf '  exportar-tema <id> [flavor] [arquivo.tar.gz]\n'
      printf '                   o tema de ícones montado, com a base, pronto para instalar\n'
      printf '  importar <arquivo.meowpack|arquivo.csv>\n'
      printf '                   confere, e instala como opção — não troca o seu tema\n'
      printf '  remover <id>     tira um pack que você importou; o que vem com o MeowSystem,\n'
      printf '                   o que está no ar e o que outro pack herda ficam\n'
      printf '  de-csv <arq>     a paleta.json de um CSV slot,flavor,hex; só imprime\n'
      printf '  raizes           onde o MeowSystem procura\n\n'
      printf 'A especificação do formato está em docs/PACKS.md.\n'
      ;;
    *) meow_erro "verbo desconhecido: $acao"; meow_info "veja: meow pack --help"; return "$MEOW_ERRO" ;;
  esac
}

despachar() {
  case "${1:-}" in
    ""|menu)          cmd_menu ;;
    status|estado)    shift; cmd_status "$@" ;;
    doctor|medico)    shift; cmd_doctor "$@" ;;
    tema)             shift; cmd_tema "$@" ;;
    logo)             shift; cmd_logo "$@" ;;
    icones|ícones)    shift; cmd_icones "$@" ;;
    cursor|ponteiro)  shift; cmd_cursor "$@" ;;
    areas|áreas|area) shift; cmd_areas "$@" ;;
    fontes|fonte)     shift; cmd_fontes "$@" ;;
    wallpaper|parede) shift; cmd_wallpaper "$@" ;;
    files-menu|menu-arquivos) shift
      carregar_conf || exit "$MEOW_ERRO"
      case "${1:-estado}" in
        build|aplicar) meow_travar || exit "$MEOW_ERRO" ;;
      esac
      FILES_MENU="${FILES_MENU:-sim}" FILES_MENU_AUTOBUILD="${FILES_MENU_AUTOBUILD:-sim}" \
        "$RAIZ/scripts/files_menu.sh" "${1:-estado}"; exit $? ;;
    apps)             shift; cmd_apps "$@" ;;
    configurar|config|wizard) shift; cmd_configurar "$@" ;;
    painel)           shift; cmd_painel "$@" ;;
    pack|packs)       shift; cmd_pack "$@" ;;
    leitura)          shift; cmd_leitura "$@" ;;
    compositor)       shift; cmd_compositor "$@" ;;
    cosmic)           shift
      case "${1:-prever}" in
        prever|ler|icones) "$RAIZ/scripts/cosmic_prever.sh" "$@"; exit $? ;;
        sentinela) shift; "$RAIZ/scripts/sentinela.sh" "$@"; exit $? ;;
        -h|--help|ajuda)
          printf '  meow cosmic prever [--sem-rede]  o veredito sobre o COSMIC da fila do apt, antes do upgrade\n'
          printf '  meow cosmic ler                  o último veredito gravado\n'
          printf '  meow cosmic icones               os apps do COSMIC instalados sem desenho em mapa nenhum\n'
          printf '  meow cosmic sentinela [ler]      a medida diária da fila do apt (roda sozinha, uma vez por dia)\n' ;;
        *) meow_erro "verbo desconhecido: $1"; meow_info "veja: meow cosmic --help"; exit "$MEOW_ERRO" ;;
      esac ;;
    abrir|app)        shift; exec "$RAIZ/app/run.sh" "$@" ;;
    aplicar|ativar)   shift; cmd_aplicar "$@" ;;
    desfazer)         shift; cmd_desfazer "$@" ;;
    restaurar)        shift; cmd_restaurar "$@" ;;
    log)              shift; cmd_log "$@" ;;
    ajuda|-h|--help|help) cmd_ajuda ;;
    *) meow_erro "comando desconhecido: $1"
       meow_info "veja: meow --help  (ou 'meow' sem argumento para o menu)"
       return "$MEOW_ERRO" ;;
  esac
}

if [ "$(id -u)" = "0" ]; then
  meow_erro "com sudo, não: os arquivos de ~/.config ficariam de dono root — nada foi feito."
  meow_info "  o meow roda como o seu usuário, e pede o sudo por dentro onde precisa"
  exit 2
fi

despachar "$@"
