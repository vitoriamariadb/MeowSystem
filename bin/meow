chk_autoreparo() {
  local destino="$HOME/.config/systemd/user" u faltam=() difere=()

  if [ "${AUTO_REPARO:-sim}" != "sim" ]; then
    if [ -f "$destino/meow-doctor.timer" ] || [ -f "$destino/meow-doctor.service" ]; then
      echo "AUTO_REPARO=\"${AUTO_REPARO:-}\" no meow.conf, mas o meow-doctor continua em $destino"
      return "$MEOW_DIVERGENTE"
    fi
    echo "AUTO_REPARO=\"${AUTO_REPARO:-}\" — sem reparo automático, por escolha sua"
    return "$MEOW_SEM_DEPENDENCIA"
  fi

  if ! meow_tem systemctl || [ ! -d "/run/user/$(id -u)/systemd" ]; then
    echo "não há systemd --user nesta sessão — o conserto diário fica de fora; o «Consertar», no Manter, faz o mesmo"
    return "$MEOW_SEM_DEPENDENCIA"
  fi

  for u in meow-doctor.service meow-doctor.timer; do
    [ -f "$RAIZ/systemd/$u" ] || { echo "falta $RAIZ/systemd/$u — repositório incompleto"; return "$MEOW_ERRO"; }
    if [ ! -f "$destino/$u" ]; then faltam+=("$u"); continue; fi
    meow_mesmo_conteudo "$RAIZ/systemd/$u" "$destino/$u" || difere+=("$u")
  done

  local armado=1
  [ "$(systemctl --user is-enabled meow-doctor.timer 2>/dev/null)" = "enabled" ] || armado=0
  [ "$(systemctl --user is-active  meow-doctor.timer 2>/dev/null)" = "active"  ] || armado=0

  if [ "${#faltam[@]}" -gt 0 ] || [ "${#difere[@]}" -gt 0 ] || [ "$armado" = "0" ]; then
    [ "${#faltam[@]}" -gt 0 ] && echo "não estão instaladas: ${faltam[*]}"
    [ "${#difere[@]}" -gt 0 ] && echo "diferentes das do repositório: ${difere[*]}"
    [ "$armado" = "0" ] && echo "o meow-doctor.timer não está armado — o reparo das 5h não dispara"
    return "$MEOW_DIVERGENTE"
  fi
  echo "auto-reparo ligado (meow-doctor.timer, todo dia às 5h, com até 20min de folga)"
  return 0
}

chk_cli() {
  local alvo="$HOME/.local/bin/meow" ponteiro="$MEOW_ESTADO/raiz" ruins=() extra="" aponta
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) extra="aviso: ~/.local/bin não está no \$PATH — o comando 'meow' não vai ser achado" ;;
  esac

  if [ ! -f "$alvo" ]; then
    echo "~/.local/bin/meow não existe — o conserto copia o bin/meow deste clone"
    [ -n "$extra" ] && echo "$extra"
    return "$MEOW_DIVERGENTE"
  fi
  meow_mesmo_conteudo "$alvo" "$RAIZ/bin/meow" || ruins+=("a CLI em ~/.local/bin/meow está diferente do bin/meow deste clone")
  [ -x "$alvo" ] || ruins+=("~/.local/bin/meow está sem bit de execução — seria um 'command not found' inexplicável")
  if [ ! -f "$ponteiro" ]; then
    ruins+=("$ponteiro não existe — a CLI e a completion não acham o clone")
  else
    aponta="$(cat "$ponteiro" 2>/dev/null)"
    [ "$aponta" = "$RAIZ" ] || ruins+=("$ponteiro aponta para '$aponta', e este clone é '$RAIZ'")
  fi

  if [ "${#ruins[@]}" -gt 0 ]; then
    printf '%s\n' "${ruins[@]}"
    [ -n "$extra" ] && echo "$extra"
    return "$MEOW_DIVERGENTE"
  fi
  echo "a CLI instalada é byte a byte o bin/meow, e o ponteiro da raiz confere"
  [ -n "$extra" ] && echo "$extra"
  return 0
}

_pacotes_faltando() {
  local faltam=() par bin pac
  while IFS= read -r par; do
    [ -n "$par" ] || continue
    bin="${par%%=*}"; bin="${bin#[}"; bin="${bin%]}"
    pac="${par#*=}"
    meow_tem "$bin" || faltam+=("$pac")
  done < <(sed -n '/^etapa_pacotes()/,/^}/p' "$RAIZ/install.sh" \
           | grep -oE '^[[:space:]]*\[[a-zA-Z0-9_.+-]+\]=[a-zA-Z0-9_.+-]+' \
           | tr -d '[:blank:]')
  [ "${#faltam[@]}" -gt 0 ] || {
    local lidos
    lidos="$(sed -n '/^etapa_pacotes()/,/^}/p' "$RAIZ/install.sh" \
             | grep -cE '^[[:space:]]*\[[a-zA-Z0-9_.+-]+\]=[a-zA-Z0-9_.+-]+')"
    [ "${lidos:-0}" -gt 0 ] || { echo "não consegui ler a lista de pacotes do install.sh"; return "$MEOW_ERRO"; }
  }
  [ -d /usr/share/icons/Papirus-Dark ] || faltam+=(papirus-icon-theme)
  python3 -I -c 'import numpy' 2>/dev/null || faltam+=(python3-numpy)
  [ -d /usr/share/fonts/opentype/fira ] || ! apt-cache show pop-fonts >/dev/null 2>&1 \
    || faltam+=(pop-fonts)
  local prova pacote
  if [ "${MIDIA:-sim}" = "sim" ] || [ "${LEITURA_APPLET:-sim}" = "sim" ]; then
    while IFS='|' read -r prova pacote; do
      [ -e "$prova" ] || faltam+=("$pacote")
    done <<< "$MEOW_DEPS_DOS_APPLETS"
  fi
  [ "${#faltam[@]}" -eq 0 ] || printf '%s\n' "${faltam[@]}"
  return 0
}

chk_pacotes() {
  local lista faltam=()
  lista="$(_pacotes_faltando)" || { echo "$lista"; return "$MEOW_ERRO"; }
  [ -n "$lista" ] && mapfile -t faltam <<< "$lista"
  [ "${#faltam[@]}" -eq 0 ] && { echo "todos os pacotes necessários já estão instalados"; return 0; }
  if meow_ponte_viva; then
    echo "faltam: ${faltam[*]} — o conserto os instala pela ponte root, sem senha"
  else
    echo "faltam: ${faltam[*]} — sem a ponte root, instalar pacote pede a sua senha uma vez, no ./install.sh"
  fi
  return "$MEOW_DIVERGENTE"
}

