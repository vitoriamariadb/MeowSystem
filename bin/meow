  saida="$("$RAIZ/scripts/instalar_fontes.sh" --conferir 2>&1)"; rc=$?
  saida="$(printf '%s\n' "$saida" | sed '/^[[:space:]]*$/d')"
  printf '%s\n' "$saida" | tail -n 1
  printf '%s\n' "$saida" | sed '$d'
  return "$rc"
}

