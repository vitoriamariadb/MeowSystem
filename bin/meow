chk_svg() {
  meow_tem python3 || { echo "python3 não está aqui — nada a conferir"; return 0; }
  local pastas=() p
  for p in packs/meowsystem/mascote/ packs/dracula/mascote/ assets/icones/overrides; do
    [ -d "$RAIZ/$p" ] && pastas+=("$RAIZ/$p")
  done
  for p in "$RAIZ"/packs/meowsystem/icones/sistema/leitura-*.svg; do [ -f "$p" ] && pastas+=("$p"); done
  while IFS= read -r p; do [ -n "$p" ] && pastas+=("$p"); done < <(python3 -I - "$RAIZ" <<'PYAUT' 2>/dev/null
import glob, json, os, sys
for d in sorted(glob.glob(os.path.join(sys.argv[1], "packs", "*"))):
    try:
        fl = json.load(open(os.path.join(d, "paleta.json"), encoding="utf-8"))["flavors"]
    except Exception:
        continue
    for f in sorted(glob.glob(os.path.join(d, "icones", "apps", "*.svg"))):
        if any(f.endswith("-%s.svg" % x) for x in fl):
            print(f)
PYAUT
  )
  [ "${#pastas[@]}" -gt 0 ] || return 0
  local saida rc
  saida="$(python3 "$RAIZ/scripts/normalizar_svg.py" --conferir "${pastas[@]}" 2>&1)"; rc=$?
  if [ "$rc" = "0" ]; then
    printf '%s desenho(s) nossos conferem com o que o painel sabe desenhar\n' \
      "$(find "${pastas[@]}" -name '*.svg' 2>/dev/null | wc -l)"
    return 0
  fi
  printf '%s\n' "$saida"
  return "$rc"
}

