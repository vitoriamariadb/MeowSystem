fix_conf() {
  [ -f "$CONF" ] || { meow_pula "o meow.conf nasce no ./install.sh, a partir do exemplo"; return "$MEOW_SEM_DEPENDENCIA"; }
  if meow_seco; then
    meow_muda "migraria o meow.conf: $(python3 "$RAIZ/scripts/migrar_conf.py" "$CONF" "$CONF_PADRAO" --conferir 2>&1 | em_linha)"
    return "$MEOW_DIVERGENTE"
  fi
  local saida
  saida="$(python3 "$RAIZ/scripts/migrar_conf.py" "$CONF" "$CONF_PADRAO" 2>&1)" ||
    { meow_erro "não consegui migrar o meow.conf: $saida"; return "$MEOW_ERRO"; }
  [ -n "$saida" ] || return 0
  meow_ok "$saida"
  return "$MEOW_DIVERGENTE"
}

recarregar_conf_migrado() {
  local k
  for k in $(python3 -I -B -c 'import sys; sys.path.insert(0, sys.argv[1]); import migrar_conf; print(" ".join(migrar_conf.APOSENTADAS))' \
               "$RAIZ/scripts" 2>/dev/null); do
    unset "$k"
  done
  carregar_conf --ponte-opcional >/dev/null 2>&1
}

fix_pacotes() {
  local lista
  lista="$(_pacotes_faltando)" || { echo "$lista"; return "$MEOW_ERRO"; }
  [ -n "$lista" ] || return 0
  if meow_seco; then
    meow_muda "instalaria pela ponte root: $(printf '%s' "$lista" | em_linha)"
    return "$MEOW_DIVERGENTE"
  fi
  if ! printf '%s\n' "$lista" | meow_ponte pacotes 2>&1; then
    meow_erro "a ponte root não instalou: $(printf '%s' "$lista" | em_linha)"
    return "$MEOW_ERRO"
  fi
  meow_ok "instalados pela ponte root: $(printf '%s' "$lista" | em_linha)"
  return "$MEOW_DIVERGENTE"
}
