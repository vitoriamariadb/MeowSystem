_ponte_reparo_ha() {
  [ -f /usr/local/lib/meowsystem/reserva.sha256 ] &&
    [ "$(systemctl show -p LoadState --value meowsystem-ponte-reparo.service 2>/dev/null)" = loaded ]
}

_ponte_reparo_motivo() {
  if ! _ponte_reparo_ha; then
    printf ' — sem reserva, entra no «Instalar tudo»'
    return 0
  fi
  local u=meowsystem-ponte-reparo.service
  if [ "$(systemctl show -p Result --value "$u" 2>/dev/null)" = exit-code ]; then
    case "$(systemctl show -p ExecMainStatus --value "$u" 2>/dev/null)" in
      3) printf ' — sem reserva, entra no «Instalar tudo»'; return 0 ;;
      4) printf ' — a reserva não confere com o sha256, entra no «Instalar tudo»'; return 0 ;;
      5) printf ' — a regra da reserva não passa no visudo, entra no «Instalar tudo»'; return 0 ;;
    esac
  fi
  printf ' — o reparo a repõe da reserva'
}

_ponte_regra_igual_a_reserva() {
  grep -q '^regra_sha256=' <<< "$1" || return 0
  [ "$(sed -n 's/^regra_sha256=//p' <<< "$1")" = \
    "$(sed -n 's/  49-meowsystem-ponte$//p' /usr/local/lib/meowsystem/reserva.sha256 2>/dev/null)" ]
}

chk_ponte() {
  local ponte=/usr/local/lib/meowsystem/ponte_root.sh
  local regra=/etc/sudoers.d/49-meowsystem-ponte
  local somas=/usr/local/lib/meowsystem/reserva.sha256
  local origem="$RAIZ/scripts/ponte_root.sh"

  if [ "${PONTE_ROOT:-sim}" != "sim" ]; then
    if [ -e "$ponte" ] || [ -e "$regra" ]; then
      meow_muda 'PONTE_ROOT="nao" mas a ponte root continua instalada'
      return "$MEOW_DIVERGENTE"
    fi
    meow_pula 'PONTE_ROOT="nao" — cada conserto de sistema pede senha no terminal'
    return "$MEOW_SEM_DEPENDENCIA"
  fi

  local falta=""
  if [ ! -x "$ponte" ]; then
    falta="falta $ponte"
  elif [ ! -f "$regra" ]; then
    falta="falta $regra"
  elif [ -f "$somas" ] &&
       [ "$(sha256sum < "$ponte" | cut -d' ' -f1)" != "$(sed -n 's/  ponte_root\.sh$//p' "$somas")" ]; then
    falta="$ponte difere da reserva"
  fi
  if [ -n "$falta" ]; then
    meow_muda "$falta$(_ponte_reparo_motivo)"
    return "$MEOW_DIVERGENTE"
  fi

  local estado
  if ! estado="$(sudo -n "$ponte" estado 2>/dev/null)"; then
    meow_muda "a regra existe e o sudo ainda pede senha para a ponte$(_ponte_reparo_motivo)"
    return "$MEOW_DIVERGENTE"
  fi

  if ! _ponte_reparo_ha; then
    meow_muda "a ponte está sem reserva — entra no «Instalar tudo»"
    return "$MEOW_DIVERGENTE"
  fi

  if ! _ponte_regra_igual_a_reserva "$estado"; then
    meow_muda "$regra difere da reserva$(_ponte_reparo_motivo)"
    return "$MEOW_DIVERGENTE"
  fi
  if grep -q '^polkit_sha256=' <<< "$estado"; then
    local polkit_tem
    polkit_tem="$(sed -n 's/^polkit_sha256=//p' <<< "$estado")"
    if [ -z "$polkit_tem" ]; then
      meow_muda "falta a regra do polkit do reparo — entra no «Instalar tudo»"
      return "$MEOW_DIVERGENTE"
    fi
    if [ "$polkit_tem" != "$(sha256sum < "$RAIZ/assets/ponte/49-meowsystem-ponte-reparo.rules" 2>/dev/null | cut -d' ' -f1)" ]; then
      meow_muda "a regra do polkit do reparo difere do repositório — entra no «Instalar tudo»"
      return "$MEOW_DIVERGENTE"
    fi
  fi

  cmp -s "$origem" "$ponte" 2>/dev/null ||
    { meow_muda "a ponte do repositório mudou — entra no «Instalar tudo»"; return "$MEOW_DIVERGENTE"; }

  local raiz_reg
  raiz_reg="$(sed -n 's/^raiz=//p' <<< "$estado")"
  if [ "$raiz_reg" != "$RAIZ" ]; then
    meow_muda "o perfil da ponte aponta para '$raiz_reg', e o clone está em '$RAIZ'"
    return "$MEOW_DIVERGENTE"
  fi

  meow_ok "ponte root no ar — o conserto de sistema não pede senha"
  return 0
}

fix_ponte() {
  local u=meowsystem-ponte-reparo.service
  if [ "${PONTE_ROOT:-sim}" != "sim" ]; then
    meow_pula 'PONTE_ROOT="nao" — tirar a ponte entra no «Instalar tudo»'
    return "$MEOW_SEM_DEPENDENCIA"
  fi
  if ! _ponte_reparo_ha; then
    meow_pula "sem reserva — entra no «Instalar tudo»"
    return "$MEOW_SEM_DEPENDENCIA"
  fi
  local ponte=/usr/local/lib/meowsystem/ponte_root.sh estado
  if [ -x "$ponte" ] && [ -f /etc/sudoers.d/49-meowsystem-ponte ] &&
     [ "$(sha256sum < "$ponte" | cut -d' ' -f1)" = \
       "$(sed -n 's/  ponte_root\.sh$//p' /usr/local/lib/meowsystem/reserva.sha256)" ] &&
     estado="$(sudo -n "$ponte" estado 2>/dev/null)" &&
     _ponte_regra_igual_a_reserva "$estado"; then
    if cmp -s "$RAIZ/scripts/ponte_root.sh" "$ponte"; then
      meow_pula "a ponte está igual à reserva — o resto entra no «Instalar tudo»"
    else
      meow_pula "a ponte do repositório mudou — entra no «Instalar tudo»"
    fi
    return "$MEOW_SEM_DEPENDENCIA"
  fi
  if meow_seco; then
    meow_muda "repor a ponte da reserva, pelo reparo do sistema"
    return "$MEOW_DIVERGENTE"
  fi
  local erro pid rc estado antes=""
  erro="$(mktemp)" || return "$MEOW_ERRO"
  systemctl start --no-ask-password "$u" >/dev/null 2>"$erro" &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    estado="$(systemctl show -p ActiveState --value "$u" 2>/dev/null)"
    case "$estado" in activating|reloading) estado="repondo" ;; *) estado="" ;; esac
    [ -n "$estado" ] && [ "$estado" != "$antes" ] && meow_info "reparo da ponte: $estado"
    antes="$estado"
    sleep 0.2
  done
  wait "$pid"; rc=$?
  if [ "$rc" = 0 ] && [ -x "$ponte" ] && [ -f /etc/sudoers.d/49-meowsystem-ponte ]; then
    rm -f "$erro"
    meow_ok "ponte reposta da reserva, sem senha"
    return "$MEOW_DIVERGENTE"
  fi
  if grep -qiE 'authentication|access denied|not authorized' "$erro"; then
    meow_erro "o polkit recusou o reparo: só a sessão local ativa o dispara"
  else
    meow_erro "o reparo não repôs a ponte$(_ponte_reparo_motivo)"
  fi
  rm -f "$erro"
  return "$MEOW_ERRO"
}

_lancadorapt_igual_a_reserva() {
  local pecas=/usr/local/lib/meowsystem/reserva-pecas.sha256
  local hook=/etc/apt/apt.conf.d/99-meow-lancador
  local wrapper=/usr/local/sbin/meow-lancador-apt.sh
  [ -f "$pecas" ] && [ -f "$hook" ] && [ -f "$wrapper" ] || return 1
  [ "$(sha256sum < "$hook" | cut -d' ' -f1)" = "$(sed -n 's/  99-meow-lancador$//p' "$pecas")" ] &&
    [ "$(sha256sum < "$wrapper" | cut -d' ' -f1)" = "$(sed -n 's/  meow-lancador-apt\.sh$//p' "$pecas")" ]
}

chk_lancadorapt() {
  local hook=/etc/apt/apt.conf.d/99-meow-lancador
  local wrapper=/usr/local/sbin/meow-lancador-apt.sh

  if [ "${LANCADOR_SISTEMA:-nao}" != "sim" ]; then
    if [ -f "$hook" ] || [ -f "$wrapper" ]; then
      if meow_conf_diz LANCADOR_SISTEMA nao; then
        meow_muda 'LANCADOR_SISTEMA="nao" mas o hook de apt continua instalado'
        return "$MEOW_DIVERGENTE"
      fi
      meow_pula "o hook de apt está instalado e o meow.conf não diz nada — fica como está"
      return "$MEOW_SEM_DEPENDENCIA"
    fi
    meow_pula 'LANCADOR_SISTEMA="nao" — sem reaplique após apt'
    return "$MEOW_SEM_DEPENDENCIA"
  fi

  local repoe=" — a ponte o repõe da reserva"
  [ -f /usr/local/lib/meowsystem/reserva-pecas.sha256 ] || repoe=" — sem reserva, entra no «Instalar tudo»"
  [ -f "$hook" ]    || { meow_muda "falta $hook$repoe";    return "$MEOW_DIVERGENTE"; }
  [ -f "$wrapper" ] || { meow_muda "falta $wrapper$repoe"; return "$MEOW_DIVERGENTE"; }

  local esperado
  esperado="$(sed -e "s|@ACERVO@|$RAIZ|g" \
                  -e "s|@USUARIA@|$(id -un)|g" \
                  -e "s|@LAR@|$HOME|g" "$RAIZ/scripts/meow-lancador-apt.sh")"
  if ! cmp -s "$RAIZ/scripts/99-meow-lancador" "$hook" 2>/dev/null ||
     [ "$(cat "$wrapper" 2>/dev/null)" != "$esperado" ]; then
    if _lancadorapt_igual_a_reserva || [ ! -f /usr/local/lib/meowsystem/reserva-pecas.sha256 ]; then
      meow_muda "o hook do repositório mudou — entra no «Instalar tudo»"
    else
      meow_muda "o hook instalado difere da reserva$repoe"
    fi
    return "$MEOW_DIVERGENTE"
  fi

  meow_ok "o lançador se reaplica sozinho após cada apt"
  return 0
}

