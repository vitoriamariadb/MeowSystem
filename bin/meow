fix_lancadorapt() {
  if [ "${LANCADOR_SISTEMA:-nao}" != "sim" ]; then
    if ! meow_conf_diz LANCADOR_SISTEMA nao; then
      meow_aviso "o meow.conf não diz LANCADOR_SISTEMA=\"nao\" — não removo o hook"
      return "$MEOW_SEM_DEPENDENCIA"
    fi
    meow_ponte apt-hook-remover 2>&1 && meow_ok "hook de apt removido pela ponte"
    return $?
  fi
  if [ ! -f /usr/local/lib/meowsystem/reserva-pecas.sha256 ]; then
    meow_pula "sem reserva — entra no «Instalar tudo»"
    return "$MEOW_SEM_DEPENDENCIA"
  fi
  if _lancadorapt_igual_a_reserva; then
    meow_pula "o hook do repositório mudou — entra no «Instalar tudo»"
    return "$MEOW_SEM_DEPENDENCIA"
  fi
  if meow_ponte apt-hook-instalar 2>&1; then
    meow_ok "hook de apt reposto da reserva, pela ponte"
    return "$MEOW_DIVERGENTE"
  fi
  meow_aviso "a ponte não repôs o hook de apt"
  return "$MEOW_ERRO"
}
