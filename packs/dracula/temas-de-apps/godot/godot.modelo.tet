control_flow_keyword_color="{{mauve}}"
base_type_color="{{yellow}}"
engine_type_color="{{yellow}}"
user_type_color="{{yellow}}"
comment_color="{{overlay1}}"
doc_comment_color="{{overlay2}}"
string_color="{{green}}"
string_placeholder_color="{{peach}}"
background_color="{{base}}"
completion_background_color="{{mantle}}"
completion_selected_color="{{surface1}}"
completion_existing_color="{{text:26}}"
completion_scroll_color="{{text:4d}}"
completion_scroll_hovered_color="{{text:73}}"
completion_font_color="{{text}}"
text_color="{{text}}"
line_number_color="{{overlay0}}"
safe_line_number_color="{{green}}"
caret_color="{{rosewater}}"
caret_background_color="{{base}}"
text_selected_color="{{text:00}}"
selection_color="{{overlay2:40}}"
brace_mismatch_color="{{red}}"
current_line_color="{{overlay2:1a}}"
line_length_guideline_color="{{surface0}}"
word_highlighted_color="{{overlay2:26}}"
number_color="{{peach}}"
function_color="{{blue}}"
member_variable_color="{{flamingo}}"
mark_color="{{red:4d}}"
warning_color="{{yellow:26}}"
error_underline_color="{{red}}"
warning_underline_color="{{yellow}}"
bookmark_color="{{blue}}"
breakpoint_color="{{red}}"
executing_line_color="{{yellow}}"
code_folding_color="{{overlay1}}"
folded_code_region_color="{{mauve:33}}"
search_result_color="{{green:33}}"
search_result_border_color="{{blue:61}}"
gdscript/function_definition_color="{{blue}}"
gdscript/global_function_color="{{lavender}}"
gdscript/node_path_color="{{teal}}"
gdscript/node_reference_color="{{teal}}"
gdscript/annotation_color="{{pink}}"
gdscript/string_name_color="{{flamingo}}"
comment_markers/critical_color="{{red}}"
comment_markers/warning_color="{{yellow}}"
comment_markers/notice_color="{{green}}"

[meowsystem]

tipo="{{tipo}}"
base_color="{{base}}"
accent_color="{{mauve}}"
contraste_dark="0.3"
contraste_light="-0.06"
