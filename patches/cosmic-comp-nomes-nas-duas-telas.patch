+    fn lugar_da_janela(&self, janela: &CosmicSurface) -> Option<(usize, usize)> {
+        self.sets.values().enumerate().find_map(|(s, set)| {
+            set.workspaces
+                .iter()
+                .position(|area| janelas_da_area(area).any(|j| &j == janela))
+                .map(|i| (s, i))
+        })
+    }
+
+    fn conferir_fundidas(&mut self) {
+        let mut fundidas = std::mem::take(&mut self.fundidas);
+        fundidas.retain_mut(|fundida| {
+            if !fundida.janela.alive() {
+                return false;
+            }
+            let Some((s, i)) = self.lugar_da_janela(&fundida.janela) else {
+                return true;
+            };
+            let (tela, set) = self.sets.get_index(s).unwrap();
+            let area = set.workspaces[i].handle;
+            let segue = lembranca_segue(area == fundida.area, *tela == fundida.tela);
+            fundida.tela = tela.clone();
+            fundida.area = area;
+            segue
+        });
+        self.fundidas = fundidas;
+    }
+
+    fn devolver_janelas(
+        &mut self,
+        nova: &Output,
+        workspace_state: &mut WorkspaceUpdateGuard<'_, State>,
+    ) {
+        self.conferir_fundidas();
+        if self.fundidas.is_empty() {
+            return;
+        }
+
+        let max = self.sets.values().map(|set| set.workspaces.len()).max();
+        for set in self.sets.values_mut() {
+            while set.workspaces.len() < max.unwrap_or(0) {
+                set.add_empty_workspace(workspace_state);
+            }
+        }
+
+        let fundidas = std::mem::take(&mut self.fundidas);
+        let mut devolvidas = Vec::new();
+        for fundida in &fundidas {
+            let saidas = self.sets.keys().collect::<Vec<_>>();
+            let Some(alvo) = saida_da_volta(&saidas, nova, |saida, exata| {
+                output_matches(&fundida.saida, saida, exata)
+            }) else {
+                continue;
+            };
+            let Some((s, i)) = self.lugar_da_janela(&fundida.janela) else {
+                continue;
+            };
+            if s == alvo {
+                continue;
+            }
+
+            let origem = &mut self.sets[s].workspaces[i];
+            let foco = origem
+                .focus_stack
+                .separar(|foco| alvo_da_janela(foco, &fundida.janela));
+            let Some(tirada) = tirar_janela(origem, &fundida.janela) else {
+                continue;
+            };
+            devolvidas.extend(tirada.janelas());
+
+            let areas = &mut self.sets[alvo].workspaces;
+            let destino = indice_da_volta(fundida.indice, areas.len());
+            por_janela(tirada, &mut areas[destino], fundida.flutuante.as_ref());
+            areas[destino].focus_stack.por_baixo(foco);
+        }
+
+        self.fundidas = fundidas;
+        self.fundidas.retain(|f| !devolvidas.contains(&f.janela));
+    }
+
+    fn copiar_nomes(&mut self, workspace_state: &mut WorkspaceUpdateGuard<'_, State>) {
+        let len = self.sets[0].workspaces.len();
+        for i in 0..len {
+            let nome = nome_da_area(self.sets.values().map(|s| {
+                let workspace = &s.workspaces[i];
+                (workspace.name.as_deref(), workspace.nome_copiado)
+            }))
+            .map(str::to_owned);
+            for set in self.sets.values_mut() {
+                let workspace = &mut set.workspaces[i];
+                if (workspace.name.is_none() || workspace.nome_copiado) && workspace.name != nome {
+                    workspace.nome_copiado = nome.is_some();
+                    workspace.name = nome.clone();
+                    workspace_set_idx(
+                        workspace_state,
+                        i as u8 + 1,
+                        &workspace.handle,
+                        workspace.name.as_deref(),
+                    );
+                }
+            }
+        }
+    }
