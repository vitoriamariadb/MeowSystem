+#[used]
+static AURORA_AREAS_NOMES: &str = "AURORA-AREAS-NOMES-2";
+
+fn nome_da_area<'a>(irmas: impl Iterator<Item = (Option<&'a str>, bool)>) -> Option<&'a str> {
+    irmas
+        .filter(|(_, copiado)| !copiado)
+        .find_map(|(nome, _)| nome)
+}
+
+#[derive(Debug, PartialEq)]
+enum AreaNaSaida {
+    Funde,
+    Substitui,
+    Segue,
+}
+
+fn area_na_saida(global: bool, sai_copiada: bool, fica_copiada: Option<bool>) -> AreaNaSaida {
+    match (global, sai_copiada, fica_copiada) {
+        (true, true, Some(_)) => AreaNaSaida::Funde,
+        (true, false, Some(true)) => AreaNaSaida::Substitui,
+        _ => AreaNaSaida::Segue,
+    }
+}
+
+fn repor_area_da_tela_cheia(previous: &mut FullscreenRestoreState, area: WorkspaceHandle) {
+    if let FullscreenRestoreState::Tiling { workspace, .. }
+    | FullscreenRestoreState::Floating { workspace, .. } = previous
+    {
+        *workspace = area;
+    }
+}
+
+#[derive(Debug)]
+struct JanelaFundida {
+    janela: CosmicSurface,
+    saida: cosmic_comp_config::workspace::OutputMatch,
+    indice: usize,
+    flutuante: Option<FloatingRestoreData>,
+    tela: Output,
+    area: WorkspaceHandle,
+}
+
+enum JanelaTirada {
+    Mapeada {
+        mapped: CosmicMapped,
+        flutuante: Option<FloatingRestoreData>,
+    },
+    Cheia {
+        janela: CosmicSurface,
+        previous: Option<FullscreenRestoreState>,
+        geometria: Option<Rectangle<i32, Local>>,
+    },
+    Minimizada(MinimizedWindow),
+}
+
+impl JanelaTirada {
+    fn janelas(&self) -> Vec<CosmicSurface> {
+        match self {
+            JanelaTirada::Mapeada { mapped, .. } => {
+                mapped.windows().map(|(janela, _)| janela).collect()
+            }
+            JanelaTirada::Cheia { janela, .. } => vec![janela.clone()],
+            JanelaTirada::Minimizada(minimizada) => minimizada.windows().collect(),
+        }
+    }
+}
+
+fn janelas_da_area(area: &Workspace) -> impl Iterator<Item = CosmicSurface> + '_ {
+    area.mapped()
+        .flat_map(|mapped| mapped.windows().map(|(janela, _)| janela))
+        .chain(area.get_fullscreen_surfaces().map(|f| f.surface.clone()))
+        .chain(area.minimized_windows.iter().flat_map(|m| m.windows()))
+}
+
+fn tirar_janela(area: &mut Workspace, janela: &CosmicSurface) -> Option<JanelaTirada> {
+    let tirada = if let Some((janela, previous, geometria)) = area.take_fullscreen(janela) {
+        janela.output_leave(&area.output);
+        JanelaTirada::Cheia {
+            janela,
+            previous,
+            geometria,
+        }
+    } else if let Some(posicao) = area
+        .minimized_windows
+        .iter()
+        .position(|m| m.windows().any(|s| &s == janela))
+    {
+        JanelaTirada::Minimizada(area.minimized_windows.remove(posicao))
+    } else {
+        let mapped = area.element_for_surface(janela)?.clone();
+        let flutuante = match area.unmap_element(&mapped)? {
+            WorkspaceRestoreData::Floating(dados) => Some(dados),
+            _ => None,
+        };
+        JanelaTirada::Mapeada { mapped, flutuante }
+    };
+    for janela in tirada.janelas() {
+        toplevel_leave_workspace(&janela, &area.handle);
+        toplevel_leave_output(&janela, &area.output);
+    }
+    Some(tirada)
+}
+
+fn por_janela(
+    tirada: JanelaTirada,
+    destino: &mut Workspace,
+    flutuante: Option<&FloatingRestoreData>,
+) {
+    for janela in tirada.janelas() {
+        toplevel_enter_workspace(&janela, &destino.handle);
+        toplevel_enter_output(&janela, &destino.output);
+    }
+    match tirada {
+        JanelaTirada::Mapeada { mapped, .. } => {
+            if let Some(dados) = flutuante {
+                let posicao = dados.position_relative(destino.output.geometry().size.as_logical());
+                destino.floating_layer.map(mapped, posicao);
+            } else if destino.tiling_enabled {
+                for maximizada in destino
+                    .mapped()
+                    .filter(|m| m.maximized_state.lock().unwrap().is_some())
+                    .cloned()
+                    .collect::<Vec<_>>()
+                {
+                    destino.unmaximize_request(&maximizada);
+                }
+                destino
+                    .tiling_layer
+                    .map(mapped, None::<std::iter::Empty<_>>, None);
+            } else {
+                destino.floating_layer.map(mapped, None);
+            }
+        }
+        JanelaTirada::Cheia {
+            janela,
+            mut previous,
+            geometria,
+        } => {
+            if let Some(previous) = &mut previous {
+                repor_area_da_tela_cheia(previous, destino.handle);
+            }
+            destino.map_fullscreen(&janela, None, previous, geometria);
+        }
+        JanelaTirada::Minimizada(mut minimizada) => {
+            match &mut minimizada {
+                MinimizedWindow::Tiling { previous, .. } => {
+                    previous.state.take();
+                }
+                MinimizedWindow::Fullscreen {
+                    previous: Some(dados),
+                    ..
+                } => repor_area_da_tela_cheia(&mut dados.previous_state, destino.handle),
+                _ => {}
+            }
+            destino.minimized_windows.push(minimizada);
+        }
+    }
+}
+
+fn lembrar_janelas(
+    fundidas: &mut Vec<JanelaFundida>,
+    tirada: &JanelaTirada,
+    saida: &cosmic_comp_config::workspace::OutputMatch,
+    indice: usize,
+    destino: &Workspace,
+) {
+    let flutuante = match tirada {
+        JanelaTirada::Mapeada { flutuante, .. } => flutuante.clone(),
+        _ => None,
+    };
+    for janela in tirada.janelas() {
+        if let Some(lembrada) = fundidas.iter_mut().find(|f| f.janela == janela) {
+            lembrada.tela = destino.output.clone();
+            lembrada.area = destino.handle;
+        } else {
+            fundidas.push(JanelaFundida {
+                janela,
+                saida: saida.clone(),
+                indice,
+                flutuante: flutuante.clone(),
+                tela: destino.output.clone(),
+                area: destino.handle,
+            });
+        }
+    }
+}
+
+fn fundir_area(
+    mut area: Workspace,
+    destino: &mut Workspace,
+    saida: cosmic_comp_config::workspace::OutputMatch,
+    indice: usize,
+    fundidas: &mut Vec<JanelaFundida>,
+    workspace_state: &mut WorkspaceUpdateGuard<'_, State>,
+) {
+    let foco = std::mem::take(&mut area.focus_stack);
+
+    for janela in janelas_da_area(&area).collect::<Vec<_>>() {
+        let Some(tirada) = tirar_janela(&mut area, &janela) else {
+            continue;
+        };
+        lembrar_janelas(fundidas, &tirada, &saida, indice, destino);
+        por_janela(tirada, destino, None);
+    }
+
+    destino.focus_stack.por_baixo(foco);
+    workspace_state.remove_workspace(area.handle);
+}
+
+fn alvo_da_janela(alvo: &FocusTarget, janela: &CosmicSurface) -> bool {
+    match alvo {
+        FocusTarget::Window(mapped) => mapped.windows().any(|(s, _)| &s == janela),
+        FocusTarget::Fullscreen(s) => s == janela,
+    }
+}
+
+fn lembranca_segue(mesma_area: bool, mesma_tela: bool) -> bool {
+    mesma_area || mesma_tela
+}
+
+fn indice_da_volta(indice: usize, areas: usize) -> usize {
+    indice.min(areas.saturating_sub(1))
+}
+
+fn saida_da_volta<T: PartialEq>(
+    saidas: &[&T],
+    nova: &T,
+    casa: impl Fn(&T, bool) -> bool,
+) -> Option<usize> {
+    let exata = saidas.iter().position(|saida| casa(saida, true));
+    exata.or_else(|| {
+        casa(nova, false)
+            .then(|| saidas.iter().position(|saida| *saida == nova))
+            .flatten()
+    })
+}
