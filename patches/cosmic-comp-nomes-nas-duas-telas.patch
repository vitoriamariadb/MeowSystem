+
+fn nome_da_area<'a>(irmas: impl Iterator<Item = (Option<&'a str>, bool)>) -> Option<&'a str> {
+    irmas
+        .filter(|(_, copiado)| !copiado)
+        .find_map(|(nome, _)| nome)
+}
+
+#[derive(Debug, PartialEq)]
+enum AreaNaSaida {
+    Funde,
+    Substitui,
+    Segue,
+}
+
+fn area_na_saida(global: bool, sai_copiada: bool, fica_copiada: Option<bool>) -> AreaNaSaida {
+    match (global, sai_copiada, fica_copiada) {
+        (true, true, Some(_)) => AreaNaSaida::Funde,
+        (true, false, Some(true)) => AreaNaSaida::Substitui,
+        _ => AreaNaSaida::Segue,
+    }
+}
+
+fn repor_area_da_tela_cheia(previous: &mut FullscreenRestoreState, area: WorkspaceHandle) {
+    if let FullscreenRestoreState::Tiling { workspace, .. }
+    | FullscreenRestoreState::Floating { workspace, .. } = previous
+    {
+        *workspace = area;
+    }
+}
+
+fn fundir_area(
+    mut area: Workspace,
+    destino: &mut Workspace,
+    workspace_state: &mut WorkspaceUpdateGuard<'_, State>,
+) {
+    let de = area.handle;
+    let para = destino.handle;
+
+    for mapped in area.mapped().cloned().collect::<Vec<_>>() {
+        if area.unmap_element(&mapped).is_none() {
+            continue;
+        }
+        for (janela, _) in mapped.windows() {
+            toplevel_leave_workspace(&janela, &de);
+            toplevel_enter_workspace(&janela, &para);
+        }
+        if destino.tiling_enabled {
+            for maximizada in destino
+                .mapped()
+                .filter(|m| m.maximized_state.lock().unwrap().is_some())
+                .cloned()
+                .collect::<Vec<_>>()
+            {
+                destino.unmaximize_request(&maximizada);
+            }
+            destino
+                .tiling_layer
+                .map(mapped, None::<std::iter::Empty<_>>, None);
+        } else {
+            destino.floating_layer.map(mapped, None);
+        }
+    }
+
+    let cheias = area
+        .get_fullscreen_surfaces()
+        .map(|f| f.surface.clone())
+        .collect::<Vec<_>>();
+    for janela in cheias {
+        let Some((janela, mut previous_state, previous_geometry)) = area.take_fullscreen(&janela)
+        else {
+            continue;
+        };
+        toplevel_leave_workspace(&janela, &de);
+        toplevel_enter_workspace(&janela, &para);
+        if let Some(previous) = &mut previous_state {
+            repor_area_da_tela_cheia(previous, para);
+        }
+        destino.map_fullscreen(&janela, None, previous_state, previous_geometry);
+    }
+
+    for mut minimizada in area.minimized_windows.drain(..) {
+        for janela in minimizada.windows() {
+            toplevel_leave_workspace(&janela, &de);
+            toplevel_enter_workspace(&janela, &para);
+        }
+        match &mut minimizada {
+            MinimizedWindow::Tiling { previous, .. } => {
+                previous.state.take();
+            }
+            MinimizedWindow::Fullscreen {
+                previous: Some(dados),
+                ..
+            } => repor_area_da_tela_cheia(&mut dados.previous_state, para),
+            _ => {}
+        }
+        destino.minimized_windows.push(minimizada);
+    }
+
+    workspace_state.remove_workspace(de);
+}
