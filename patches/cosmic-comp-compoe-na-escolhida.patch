# cosmic-comp-compoe-na-escolhida.patch
#
# MARCADOR: AURORA-COMPOE-NA-ESCOLHIDA-1   (base: AURORA-COMPOE-NA-ESCOLHIDA)
#
# Com COSMIC_RENDER_DEVICE definido (decisão 6), toda tela é composta na GPU escolhida, e a que liga a tela só
# recebe o quadro pronto. Upstream, render_node_for_output devolve a GPU da tela quando a área não tem janela da
# escolhida: no nitro-5 a AMD do eDP passava a compor com texturas de cliente feitas na RTX (modifier NVIDIA) e
# falhava («import for wrong devices», o verde), e todo render na AMD expunha o page fault que derrubou a sessão
# em 16/11 (P209). Sem a variável, nada muda.
#
--- a/src/backend/kms/surface/mod.rs
+++ b/src/backend/kms/surface/mod.rs
@@ -1486,6 +1486,12 @@
     .flatten()
 }
 
+#[used]
+static AURORA_COMPOE_NA_ESCOLHIDA: &str = "AURORA-COMPOE-NA-ESCOLHIDA-1";
+
+static GPU_ESCOLHIDA: std::sync::LazyLock<bool> =
+    std::sync::LazyLock::new(|| std::env::var_os("COSMIC_RENDER_DEVICE").is_some());
+
 // TODO: Introduce can_shared_dmabuf_framebuffer for cases where we might select another gpu
 //  and composite on target if not possible to finally get rid of "primary"
 #[profiling::function]
@@ -1495,8 +1501,8 @@
     target_node: &DrmNode,
     shell: &Shell,
 ) -> DrmNode {
-    if target_node == primary_node {
-        return *target_node;
+    if target_node == primary_node || *GPU_ESCOLHIDA {
+        return *primary_node;
     }
 
     let Some(workspace) = shell.active_space(output) else {
