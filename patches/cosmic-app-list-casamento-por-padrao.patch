+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn entries(ids: &[&str]) -> Vec<DesktopEntry> {
+        ids.iter()
+            .map(|id| DesktopEntry::from_appid((*id).to_string()))
+            .collect()
+    }
+
+    fn matched(ids: &[&str], app_id: &str) -> Option<String> {
+        let entries = entries(ids);
+        find_app_by_pattern(&entries, app_id).map(|entry| entry.id().to_string())
+    }
+
+    #[test]
+    fn marker_is_kept() {
+        assert_eq!(MEOW_DOCK_PATCH, "MEOW-DOCK-PATCH-1");
+    }
+
+    #[test]
+    fn same_id_ignoring_case() {
+        assert_eq!(
+            matched(&["org.gnome.Nautilus"], "org.gnome.nautilus").as_deref(),
+            Some("org.gnome.Nautilus")
+        );
+    }
+
+    #[test]
+    fn role_suffix_glued_to_the_id() {
+        assert_eq!(
+            matched(
+                &["com.system76.CosmicFiles"],
+                "com.system76.CosmicFilesDialog"
+            )
+            .as_deref(),
+            Some("com.system76.CosmicFiles")
+        );
+    }
+
+    #[test]
+    fn role_suffix_after_dot_or_dash() {
+        let ids = ["org.example.App", "keepassxc"];
+        assert_eq!(
+            matched(&ids, "org.example.App.Portal").as_deref(),
+            Some("org.example.App")
+        );
+        assert_eq!(
+            matched(&ids, "keepassxc-helper").as_deref(),
+            Some("keepassxc")
+        );
+    }
+
+    #[test]
+    fn every_known_role_suffix() {
+        for suffix in ["Dialog", "Portal", "Prompt", "Prompter", "Helper", "Agent"] {
+            assert_eq!(
+                matched(&["org.example.App"], &format!("org.example.App{suffix}")).as_deref(),
+                Some("org.example.App"),
+                "{suffix}"
+            );
+        }
+    }
+
+    #[test]
+    fn unknown_suffix_is_not_stripped() {
+        assert_eq!(matched(&["org.example.App"], "org.example.AppWindow"), None);
+    }
+
+    #[test]
+    fn suffix_alone_is_not_an_id() {
+        assert_eq!(
+            matched(&["Dialog", "org"], "Dialog"),
+            Some("Dialog".to_string())
+        );
+        assert_eq!(strip_role_suffix("Dialog"), None);
+        assert_eq!(strip_role_suffix(".Dialog"), None);
+    }
+
+    #[test]
+    fn longest_reverse_domain_prefix() {
+        let ids = [
+            "org.gnome",
+            "org.gnome.Nautilus",
+            "org.gnome.NautilusPreviewer",
+        ];
+        assert_eq!(
+            matched(&ids, "org.gnome.Nautilus.Previewer").as_deref(),
+            Some("org.gnome.Nautilus")
+        );
+    }
+
+    #[test]
+    fn prefix_must_end_at_a_dot() {
+        assert_eq!(
+            matched(&["org.gnome.Nautilus"], "org.gnome.NautilusX"),
+            None
+        );
+        assert_eq!(
+            matched(&["org.gnome.Nautilus"], "org.gnome.Nautilus."),
+            None
+        );
+    }
+
+    #[test]
+    fn prefix_without_a_domain_is_ignored() {
+        assert_eq!(matched(&["firefox"], "firefox.Toolbox"), None);
+    }
+
+    #[test]
+    fn ambiguous_prefix_matches_nothing() {
+        let entries = vec![
+            DesktopEntry::from_appid("org.example.App".to_string()),
+            DesktopEntry::from_appid("org.example.APP".to_string()),
+        ];
+        assert!(find_app_by_reverse_domain_prefix(&entries, "org.example.App.Tool").is_none());
+    }
+
+    #[test]
+    fn same_id_twice_is_not_ambiguous() {
+        assert_eq!(
+            matched(
+                &["org.example.App", "org.example.App"],
+                "org.example.App.Tool"
+            )
+            .as_deref(),
+            Some("org.example.App")
+        );
+    }
+
+    #[test]
+    fn rules_run_in_order() {
+        let ids = [
+            "com.example.Tool",
+            "com.example.ToolDialog.extra",
+            "com.example",
+        ];
+        assert_eq!(
+            matched(&ids, "com.example.tooldialog").as_deref(),
+            Some("com.example.Tool")
+        );
+        let ids = ["com.example.App", "com.example.AppDialog"];
+        assert_eq!(
+            matched(&ids, "com.example.appdialog").as_deref(),
+            Some("com.example.AppDialog")
+        );
+    }
+
+    #[test]
+    fn empty_id_matches_nothing() {
+        assert_eq!(matched(&["org.example.App"], ""), None);
+    }
+
+    #[test]
+    fn proton_and_wine_ids_are_left_to_the_title_fallback() {
+        let ids = ["steam_app_default", "Game.Launcher"];
+        assert_eq!(matched(&ids, "steam_app_default"), None);
+        assert_eq!(matched(&ids, "Game.Launcher.exe"), None);
+    }
+
+    #[test]
+    fn exact_match_is_never_replaced() {
+        let entries = entries(&["com.system76.CosmicFiles", "com.system76.CosmicFilesDialog"]);
+        let app_id = "com.system76.CosmicFilesDialog";
+        let exact = fde::find_app_by_id(&entries, Ascii::new(app_id)).map(DesktopEntry::id);
+        assert_eq!(exact, Some(app_id));
+        assert_eq!(
+            find_app_by_pattern(&entries, app_id).map(DesktopEntry::id),
+            Some(app_id)
+        );
+    }
+}
