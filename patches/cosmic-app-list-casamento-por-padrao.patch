+#[used]
+static MEOW_DOCK_PATCH: &str = "MEOW-DOCK-PATCH-1";
+
+const ROLE_SUFFIXES: [&str; 6] = ["Prompter", "Prompt", "Dialog", "Portal", "Helper", "Agent"];
+
+fn strip_role_suffix(app_id: &str) -> Option<&str> {
+    ROLE_SUFFIXES.iter().find_map(|suffix| {
+        let cut = app_id.len().checked_sub(suffix.len())?;
+        if !app_id.is_char_boundary(cut) || !app_id[cut..].eq_ignore_ascii_case(suffix) {
+            return None;
+        }
+        let base = &app_id[..cut];
+        let base = base
+            .strip_suffix('.')
+            .or_else(|| base.strip_suffix('-'))
+            .unwrap_or(base);
+        (!base.is_empty()).then_some(base)
+    })
+}
+
+fn find_app_by_reverse_domain_prefix<'a>(
+    desktop_entries: &'a [DesktopEntry],
+    app_id: &str,
+) -> Option<&'a DesktopEntry> {
+    let candidates = desktop_entries.iter().filter(|entry| {
+        let id = entry.id();
+        id.contains('.')
+            && app_id.len() > id.len() + 1
+            && app_id.is_char_boundary(id.len())
+            && app_id[..id.len()].eq_ignore_ascii_case(id)
+            && app_id.as_bytes()[id.len()] == b'.'
+    });
+    let longest = candidates.clone().map(|entry| entry.id().len()).max()?;
+    let mut best = candidates.filter(|entry| entry.id().len() == longest);
+    let first = best.next()?;
+    best.all(|entry| entry.id() == first.id()).then_some(first)
+}
+
+fn find_app_by_pattern<'a>(
+    desktop_entries: &'a [DesktopEntry],
+    app_id: &str,
+) -> Option<&'a DesktopEntry> {
+    if app_id.is_empty() || app_id == "steam_app_default" || app_id.ends_with(".exe") {
+        return None;
+    }
+    let by_id = |id: &str| {
+        desktop_entries
+            .iter()
+            .find(|entry| entry.id().eq_ignore_ascii_case(id))
+    };
+    by_id(app_id)
+        .or_else(|| strip_role_suffix(app_id).and_then(by_id))
+        .or_else(|| find_app_by_reverse_domain_prefix(desktop_entries, app_id))
+}
