+#[used]
+static AURORA_APP_ID_CLIENTE: &str = "AURORA-APP-ID-CLIENTE-1";
+
+fn app_id_do_irmao<C: PartialEq>(
+    cliente: &C,
+    irmaos: impl IntoIterator<Item = (Option<C>, String)>,
+) -> Option<String> {
+    irmaos
+        .into_iter()
+        .find(|(dono, app_id)| dono.as_ref() == Some(cliente) && !app_id.is_empty())
+        .map(|(_, app_id)| app_id)
+}
+
+fn herdar_app_ids<W: Window>(toplevels: &[W]) {
+    let vivas = || toplevels.iter().filter(|janela| janela.alive());
+    for janela in vivas().filter(|janela| janela.app_id().is_empty()) {
+        let Some(cliente) = janela.client_id() else {
+            continue;
+        };
+        let herdado = app_id_do_irmao(
+            &cliente,
+            vivas().map(|irma| (irma.client_id(), irma.app_id())),
+        );
+        if let (Some(herdado), Some(estado)) = (herdado, janela.user_data().get::<ToplevelState>())
+        {
+            estado.lock().unwrap().app_id_herdado = Some(herdado);
+        }
+    }
+}
