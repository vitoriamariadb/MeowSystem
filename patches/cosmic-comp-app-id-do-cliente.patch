+#[used]
+static AURORA_APP_ID_CLIENTE: &str = "AURORA-APP-ID-CLIENTE-1";
+
+fn app_id_do_irmao<C: PartialEq>(
+    cliente: &C,
+    irmaos: impl IntoIterator<Item = (Option<C>, String)>,
+) -> Option<String> {
+    irmaos
+        .into_iter()
+        .find(|(dono, app_id)| dono.as_ref() == Some(cliente) && !app_id.is_empty())
+        .map(|(_, app_id)| app_id)
+}
+
+fn app_id_herdado<W: Window>(janela: &W, toplevels: &[W]) -> Option<String> {
+    if !janela.app_id().is_empty() {
+        return None;
+    }
+    let cliente = janela.client_id()?;
+    app_id_do_irmao(
+        &cliente,
+        toplevels
+            .iter()
+            .filter(|irma| irma.alive())
+            .map(|irma| (irma.client_id(), irma.app_id())),
+    )
+}
