#compdef meow
# OVERRIDE — escrito à mão; não gerar por scripts/gerar-completions.py.
#
# Este arquivo nasce no repo MeowSystem-Theme e o install.sh dele instala uma
# cópia em ~/.config/zsh/completions/_meow, que é o único diretório de
# completions gravável dentro do $fpath desta máquina (env.zsh, linha 20).
#
# POR QUE O MARCADOR ESTÁ NA SEGUNDA LINHA, E NÃO NA PRIMEIRA
#   O gerador de completions do Andromeda (scripts/gerar-completions.py) procura
#   "# OVERRIDE" nas TRÊS primeiras linhas de cada arquivo e preserva quem o
#   tem. A primeira linha não serve para isso: `#compdef meow` precisa estar
#   nela, senão o compinit não registra nada e o arquivo vira texto morto. Hoje
#   o gerador só escreve `_<função-zsh>` e `meow` não é uma função zsh — o
#   marcador é cinto e suspensório para o dia em que alguém definir uma.
#
# AS LISTAS SÃO LIDAS DO DISCO, NUNCA ESCRITAS AQUI
#   As capturas de tema e as variantes de logo mudam quando ela captura ou gera
#   uma nova. Uma lista fixa aqui dentro seria a terceira cópia da mesma verdade
#   e a primeira a ficar velha. A raiz do repo sai do mesmo ponteiro que a CLI
#   usa — ~/.local/state/meowsystem/raiz, gravado pelo install.sh — porque o
#   clone vive em /mnt/Apate e nada garante que ele estará sempre lá.

_meow_raiz() {
  local ponteiro="${XDG_STATE_HOME:-$HOME/.local/state}/meowsystem/raiz"
  local cand
  if [[ -n "${MEOW_RAIZ:-}" && -f "$MEOW_RAIZ/lib/comum.sh" ]]; then
    print -r -- "$MEOW_RAIZ"
    return 0
  fi
  if [[ -f "$ponteiro" ]]; then
    cand="$(<"$ponteiro")"
    cand="${cand%%$'\n'*}"
    if [[ -f "$cand/lib/comum.sh" ]]; then
      print -r -- "$cand"
      return 0
    fi
  fi
  return 1
}

_meow_capturas() {
  local raiz
  raiz="$(_meow_raiz)" || return 1
  local -a nomes
  # (/N:t) = só diretórios, sem erro quando não houver nenhum, só o nome final.
  nomes=("$raiz"/state/tema/*(/N:t))
  (( ${#nomes} )) && _describe -t capturas 'captura de tema' nomes
}

_meow_logos() {
  local raiz
  raiz="$(_meow_raiz)" || return 1
  local -a nomes
  local f
  for f in "$raiz"/assets/meow-*-painel.svg(N); do
    f="${f:t:r}"
    f="${f#meow-}"
    nomes+=("${f%-painel}")
  done
  (( ${#nomes} )) && _describe -t logos 'variante de logo' nomes
}

_meow() {
  local curcontext="$curcontext" state line
  local -a comandos
  comandos=(
    'status:painel de estado e o que está divergente'
    'doctor:confere tudo em seco; sai 1 se houver divergência'
    'tema:mostra, aplica ou captura um tema'
    'logo:variantes da logo do painel'
    'icones:estado do tema de ícones'
    'wallpaper:carrossel de papéis de parede'
    'apps:tabela de módulo, app instalado e tema'
    'aplicar:roda o install.sh inteiro'
    'desfazer:volta o tema para a captura original'
    'log:últimas 50 linhas do log'
    'ajuda:lista todos os comandos'
  )

  # Sem `&& return` depois do _arguments: com ele, o caso normal (que devolve 0)
  # sairia antes de olhar o $state e nenhum subcomando completaria nada.
  _arguments -C '1: :->comando' '*:: :->resto'

  case "$state" in
    comando)
      _describe -t comandos 'comando do meow' comandos
      ;;
    resto)
      case "$words[1]" in
        tema)
          if (( CURRENT == 2 )); then
            local -a fixos
            fixos=(
              'claro:escreve is_dark=false'
              'escuro:escreve is_dark=true'
              'auto:deixa o horário decidir'
              'capturar:fotografa o estado atual como uma captura nova'
              'desfazer:volta para a captura original'
            )
            _describe -t modos 'modo' fixos
            _meow_capturas
          fi
          ;;
        logo)
          (( CURRENT == 2 )) && _meow_logos
          ;;
        doctor)
          _arguments '--consertar[aplica só o que falhou]'
          ;;
        icones)
          if (( CURRENT == 2 )); then
            local -a acoes
            acoes=(
              'estado:só mostra'
              'reconstruir:remonta o tema de ícones e as pastas coloridas'
            )
            _describe -t acoes 'ação' acoes
          fi
          ;;
        wallpaper)
          if (( CURRENT == 2 )); then
            local -a acoes
            acoes=(
              'estado:pasta, quantas imagens, intervalo e ordem'
              'aplicar:liga ou reafirma a rotação nativa do COSMIC'
              'adicionar:copia imagem ou pasta para ativos/'
              'banir:move para banidos/ (nunca apaga)'
            )
            _describe -t acoes 'ação' acoes
          else
            case "$words[2]" in
              adicionar|banir) _files ;;
            esac
          fi
          ;;
        apps)
          if (( CURRENT == 2 )); then
            local -a acoes
            acoes=(
              'tabela:módulo, instalado, tema'
              'conferir:roda o conferir de cada módulo'
              'aplicar:tematiza um app, ou todos'
            )
            _describe -t acoes 'ação' acoes
          elif [[ "$words[2]" == aplicar ]]; then
            # Os slugs saem do meow.conf dela, não de uma lista fixa aqui.
            local conf="${MEOW_CONF:-$HOME/.config/meow/meow.conf}"
            local linha
            local -a slugs
            if [[ -f "$conf" ]]; then
              linha="$(grep -m1 '^APPS_ATIVOS=' "$conf" 2>/dev/null)"
              linha="${linha#APPS_ATIVOS=}"
              linha="${linha//\"/}"
              slugs=(${(s:,:)linha})
              (( ${#slugs} )) && _describe -t slugs 'app' slugs
            fi
          fi
          ;;
        aplicar)
          _arguments '--seco[mostra o que faria, sem escrever nada]'
          ;;
      esac
      ;;
  esac
}

_meow "$@"
