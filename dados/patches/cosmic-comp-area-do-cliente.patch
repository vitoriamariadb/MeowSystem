+
+#[used]
+static AURORA_AREA_DO_CLIENTE: &str = "AURORA-AREA-DO-CLIENTE-1";
+
+fn variavel_do_ambiente(ambiente: &[u8], nome: &str) -> Option<String> {
+    ambiente
+        .split(|byte| *byte == 0)
+        .find_map(|par| par.strip_prefix(nome.as_bytes())?.strip_prefix(b"="))
+        .map(|valor| String::from_utf8_lossy(valor).trim().to_string())
+        .filter(|valor| !valor.is_empty())
+}
+
+fn area_escolhida<A>(
+    area: &str,
+    tela: Option<&str>,
+    tela_ativa: &str,
+    areas: impl IntoIterator<Item = (A, String, Option<String>)>,
+) -> Option<A> {
+    let area = area.trim();
+    let mut achadas = areas
+        .into_iter()
+        .filter(|(_, saida, nome)| {
+            nome.as_deref().is_some_and(|nome| nome.trim() == area)
+                && tela.is_none_or(|tela| tela == saida)
+        })
+        .collect::<Vec<_>>();
+    let posicao = achadas
+        .iter()
+        .position(|(_, saida, _)| saida == tela_ativa)
+        .unwrap_or(0);
+    (!achadas.is_empty()).then(|| achadas.swap_remove(posicao).0)
+}
+
+#[cfg(test)]
+mod area_do_cliente_testes {
+    use super::{area_escolhida, variavel_do_ambiente};
+
+    fn areas() -> Vec<(u32, String, Option<String>)> {
+        vec![
+            (1, "eDP-1".to_string(), Some("\u{2007}Pop\u{2007}".to_string())),
+            (2, "eDP-1".to_string(), Some("\u{2007}OS\u{2007}".to_string())),
+            (3, "HDMI-A-1".to_string(), Some("\u{2007}Pop\u{2007}".to_string())),
+            (4, "HDMI-A-1".to_string(), Some("\u{2007}OS\u{2007}".to_string())),
+            (5, "HDMI-A-1".to_string(), None),
+        ]
+    }
+
+    #[test]
+    fn le_a_variavel_do_ambiente_do_cliente() {
+        let ambiente = b"HOME=/casa\0MEOW_AREA=OS\0MEOW_TELA=HDMI-A-1\0";
+        assert_eq!(variavel_do_ambiente(ambiente, "MEOW_AREA"), Some("OS".to_string()));
+        assert_eq!(
+            variavel_do_ambiente(ambiente, "MEOW_TELA"),
+            Some("HDMI-A-1".to_string())
+        );
+    }
+
+    #[test]
+    fn sem_a_variavel_nada_muda() {
+        let ambiente = b"HOME=/casa\0MEOW_AREAS=OS\0XMEOW_AREA=OS\0MEOW_AREA=\0";
+        assert_eq!(variavel_do_ambiente(ambiente, "MEOW_AREA"), None);
+        assert_eq!(variavel_do_ambiente(b"", "MEOW_AREA"), None);
+    }
+
+    #[test]
+    fn vale_a_primeira_como_no_getenv() {
+        let ambiente = b"MEOW_AREA=OS\0MEOW_AREA=Pop\0";
+        assert_eq!(variavel_do_ambiente(ambiente, "MEOW_AREA"), Some("OS".to_string()));
+    }
+
+    #[test]
+    fn o_nome_casa_sem_o_espaco_do_alfinete() {
+        assert_eq!(area_escolhida("OS", None, "eDP-1", areas()), Some(2));
+    }
+
+    #[test]
+    fn sem_tela_prefere_a_tela_ativa() {
+        assert_eq!(area_escolhida("OS", None, "HDMI-A-1", areas()), Some(4));
+        assert_eq!(area_escolhida("OS", None, "DP-9", areas()), Some(2));
+    }
+
+    #[test]
+    fn com_tela_vale_a_tela_pedida() {
+        assert_eq!(
+            area_escolhida("OS", Some("HDMI-A-1"), "eDP-1", areas()),
+            Some(4)
+        );
+    }
+
+    #[test]
+    fn nome_ou_tela_que_nao_existe_volta_a_fabrica() {
+        assert_eq!(area_escolhida("Jogos", None, "eDP-1", areas()), None);
+        assert_eq!(area_escolhida("OS", Some("DP-9"), "eDP-1", areas()), None);
+        assert_eq!(area_escolhida("", None, "eDP-1", areas()), None);
+    }
+}
