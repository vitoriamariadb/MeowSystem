+    pub fn area_do_cliente(
+        &self,
+        window: &CosmicSurface,
+        tela_ativa: &Output,
+    ) -> Option<(WorkspaceHandle, Output)> {
+        use smithay::reexports::wayland_server::Resource;
+
+        let pid = if let Some(toplevel) = window.0.toplevel() {
+            let surface = toplevel.wl_surface();
+            let cliente = surface.client()?;
+            surface
+                .handle()
+                .upgrade()?
+                .get_client_credentials(cliente.id())
+                .ok()?
+                .pid
+        } else {
+            i32::try_from(window.x11_surface()?.pid()?).ok()?
+        };
+        let ambiente = std::fs::read(format!("/proc/{pid}/environ")).ok()?;
+        let area = variavel_do_ambiente(&ambiente, "MEOW_AREA")?;
+        let tela = variavel_do_ambiente(&ambiente, "MEOW_TELA");
+        let escolhida = area_escolhida(
+            &area,
+            tela.as_deref(),
+            &tela_ativa.name(),
+            self.workspaces.spaces().map(|space| {
+                (
+                    (space.handle, space.output.clone()),
+                    space.output.name(),
+                    space.name.clone(),
+                )
+            }),
+        );
+        if escolhida.is_none() {
+            tracing::warn!(
+                pid,
+                ?area,
+                ?tela,
+                "MEOW_AREA sem área com esse nome: a janela nasce na área ativa"
+            );
+        }
+        escolhida
+    }
