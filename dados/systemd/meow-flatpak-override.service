[Unit]
Description=MeowSystem — tira do override global do Flatpak o xdg-config/gtk-4.0 que o cosmic-settings-daemon repõe
Documentation=file:%h/.local/state/meowsystem/flatpak-override.log
ConditionPathExists=%h/.local/state/meowsystem/raiz
StartLimitIntervalSec=300s
StartLimitBurst=20

[Service]
Type=oneshot
ExecCondition=/bin/sh -c 'C=%h/.config/meow/meow.conf; [ -f "$C" ] || exit 1; . "$C"; [ "${FLATPAK_VIGIA:-sim}" = "sim" ]'
ExecStartPre=-/bin/mkdir -p %h/.local/state/meowsystem
ExecStartPre=-/usr/bin/sleep 2
ExecStart=/usr/bin/flock -w 60 -E 0 %h/.local/state/meowsystem/lock /bin/sh -c 'R=$(cat %h/.local/state/meowsystem/raiz); [ -x "$R/scripts/flatpak_tema.sh" ] || exit 3; . %h/.config/meow/meow.conf; export FLATPAK_CORRECOES; exec "$R/scripts/flatpak_tema.sh" aplicar libadwaita'
SuccessExitStatus=1 3
TimeoutStartSec=3min
StandardOutput=append:%h/.local/state/meowsystem/flatpak-override.log
StandardError=inherit
SyslogIdentifier=meow-flatpak-override
